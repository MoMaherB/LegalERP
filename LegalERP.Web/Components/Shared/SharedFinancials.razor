@using LegalERP.Application.Financials
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@using Microsoft.Extensions.Localization
@inject CaseApiClient CaseApi
@inject CompanyApiClient CompanyApi
@inject IStringLocalizer<SharedResources> Loc

@if (financials == null)
{
    <p>@Loc["Loading"]...</p>
}
else
{
    <div class="row">
        <!-- Summary Cards -->
        <div class="col-md-4 mb-3">
            <div class="glass-card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">@Loc["AgreedFee"]</h5>
                    <div class="d-flex align-items-center">
                        <h3 class="mb-0 me-2">@(financials.AgreedFee?.ToString("N2") ?? "—")</h3>
                        <button class="btn btn-sm btn-outline-secondary glass-panel" @onclick="ToggleEditFee">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    @if (isEditingFee)
                    {
                        <div class="mt-2 d-flex gap-2">
                            <input type="number" class="form-control glass-input form-control-sm" @bind="editFeeAmount" />
                            <button class="btn btn-sm btn-success" @onclick="SaveFee">@Loc["Save"]</button>
                            <button class="btn btn-sm btn-secondary" @onclick="ToggleEditFee">@Loc["Cancel"]</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="glass-card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">@Loc["CollectedAmount"]</h5>
                    <h3 class="mb-0 text-success">@financials.TotalCollected.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="glass-card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">@Loc["RemainingBalance"]</h5>
                    <h3 class="mb-0 @GetBalanceColor(financials.PaymentStatus)">
                        @financials.RemainingBalance.ToString("N2")
                    </h3>
                    <div class="mt-2">
                        <span class="glass-badge @GetBadgeColor(financials.PaymentStatus)">
                            @TranslatePaymentStatus(financials.PaymentStatus)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Ledger -->
    <div class="glass-card mt-4">
        <div class="glass-card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Loc["FeeTransactions"]</h5>
            <button class="btn btn-sm btn-primary glass-panel" @onclick="ToggleAddTransaction">
                @(showAddTransaction ? Loc["Cancel"] : Loc["Add"])
            </button>
        </div>
        <div class="card-body">
            @if (showAddTransaction)
            {
                <div class="glass-panel p-3 rounded mb-3">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">@Loc["Amount"] *</label>
                            <input type="number" class="form-control glass-input" @bind="newTransaction.Amount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Date *</label>
                            <input type="date" class="form-control glass-input" @bind="newTransaction.TransactionDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Loc["ReceiptNumber"]</label>
                            <input type="text" class="form-control glass-input" @bind="newTransaction.ReceiptNumber" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-success w-100 glass-panel" @onclick="SaveTransaction" disabled="@isSaving">
                                @Loc["Save"]
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (!financials.Transactions.Any())
            {
                <p class="text-muted mb-0">No transactions recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-glass align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>@Loc["ReceiptNumber"]</th>
                                <th class="text-end">@Loc["Amount"]</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in financials.Transactions.OrderByDescending(t => t.TransactionDate))
                            {
                                <tr>
                                    <td>@tx.TransactionDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(tx.ReceiptNumber ?? "—")</td>
                                    <td class="text-end fw-bold text-success">@tx.Amount.ToString("N2")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger glass-panel" @onclick="() => DeleteTransaction(tx.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid OwnerId { get; set; }
    [Parameter] public string OwnerType { get; set; } = "case"; // "case" or "company"
    
    private EntityFinancialsDto? financials;
    private bool isEditingFee;
    private decimal? editFeeAmount;
    
    private bool showAddTransaction;
    private AddFeeTransactionDto newTransaction = new();
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadFinancials();
    }

    private async Task LoadFinancials()
    {
        if (OwnerType == "case")
            financials = await CaseApi.GetFinancialsAsync(OwnerId);
        else if (OwnerType == "company")
            financials = await CompanyApi.GetFinancialsAsync(OwnerId);
    }

    private void ToggleEditFee()
    {
        isEditingFee = !isEditingFee;
        if (isEditingFee)
        {
            editFeeAmount = financials?.AgreedFee;
        }
    }

    private async Task SaveFee()
    {
        var dto = new UpdateAgreedFeeDto(editFeeAmount);
        if (OwnerType == "case")
            await CaseApi.UpdateAgreedFeeAsync(OwnerId, dto);
        else if (OwnerType == "company")
            await CompanyApi.UpdateAgreedFeeAsync(OwnerId, dto);

        isEditingFee = false;
        await LoadFinancials();
    }

    private void ToggleAddTransaction()
    {
        showAddTransaction = !showAddTransaction;
        if (showAddTransaction)
        {
            newTransaction = new();
        }
    }

    private async Task SaveTransaction()
    {
        if (newTransaction.Amount <= 0) return;
        
        isSaving = true;
        try
        {
            if (OwnerType == "case")
                await CaseApi.AddFeeTransactionAsync(OwnerId, newTransaction);
            else if (OwnerType == "company")
                await CompanyApi.AddFeeTransactionAsync(OwnerId, newTransaction);

            showAddTransaction = false;
            await LoadFinancials();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteTransaction(Guid id)
    {
        if (OwnerType == "case")
            await CaseApi.DeleteFeeTransactionAsync(OwnerId, id);
        else if (OwnerType == "company")
            await CompanyApi.DeleteFeeTransactionAsync(OwnerId, id);

        await LoadFinancials();
    }

    private string GetBalanceColor(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => "text-success",
        PaymentStatus.PartiallyPaid => "text-warning",
        PaymentStatus.Unpaid => "text-danger",
        _ => ""
    };

    private string GetBadgeColor(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => "glass-badge-success",
        PaymentStatus.PartiallyPaid => "glass-badge-warning",
        PaymentStatus.Unpaid => "glass-badge-danger",
        _ => "bg-secondary"
    };

    private string TranslatePaymentStatus(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => Loc["Paid"],
        PaymentStatus.PartiallyPaid => Loc["PartiallyPaid"],
        PaymentStatus.Unpaid => Loc["Unpaid"],
        _ => status.ToString()
    };
}
