@inject IJSRuntime JSRuntime
@using System.Globalization
@using Microsoft.AspNetCore.Localization
@inject NavigationManager Navigation

<div class="dropdown">
    <button class="btn btn-outline-secondary glass-panel dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-globe me-1"></i> @(CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToUpper())
    </button>
    <ul class="dropdown-menu glass-panel" aria-labelledby="languageDropdown">
        <li>
            <a class="dropdown-item @(CultureInfo.CurrentCulture.Name == "en-US" ? "active" : "")" 
               href="Culture/Set?culture=en-US&redirectUri=@Uri.EscapeDataString(Navigation.Uri)">
               English
            </a>
        </li>
        <li>
            <a class="dropdown-item @(CultureInfo.CurrentCulture.Name == "ar-EG" ? "active" : "")" 
               href="Culture/Set?culture=ar-EG&redirectUri=@Uri.EscapeDataString(Navigation.Uri)">
               العربية
            </a>
        </li>
    </ul>
</div>

@code {
    // Controller handles the redirect
}
