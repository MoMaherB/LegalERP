@using LegalERP.Application.Companies
@inject IJSRuntime JSRuntime

@if (Document != null)
{
    <a href="@GetFileUrl()" download target="_blank" class="file-thumbnail text-decoration-none text-dark">
        @if (IsImage)
        {
            <img src="@GetFileUrl()" alt="@Document.FileName" class="thumbnail-img" />
        }
        else if (IsPdf)
        {
            <div class="pdf-icon">
                <span class="oi oi-document" aria-hidden="true"></span>
                <span class="file-ext">PDF</span>
            </div>
        }
        else if (IsWord)
        {
            <div class="pdf-icon" style="color: #0d6efd;">
                <span class="oi oi-document" aria-hidden="true"></span>
                <span class="file-ext">WORD</span>
            </div>
        }
        else
        {
            <div class="unknown-icon">
                <span class="oi oi-file" aria-hidden="true"></span>
                <span class="file-ext">FILE</span>
            </div>
        }
        <div class="file-name" title="@Document.FileName">@Document.FileName</div>
    </a>
}

@code {
    [Parameter]
    public DocumentDto? Document { get; set; }

    [Parameter]
    public string OwnerType { get; set; } = string.Empty;

    [Parameter]
    public Guid OwnerId { get; set; }

    private bool IsImage => Document?.ContentType?.StartsWith("image/") == true 
                            || Document?.FileName?.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) == true
                            || Document?.FileName?.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) == true
                            || Document?.FileName?.EndsWith(".png", StringComparison.OrdinalIgnoreCase) == true;
                            
    private bool IsPdf => Document?.ContentType == "application/pdf"
                          || Document?.FileName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;
                          
    private bool IsWord => Document?.ContentType?.Contains("word") == true
                           || Document?.FileName?.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) == true
                           || Document?.FileName?.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) == true;

    // Assuming the API is running on https://localhost:7148 (standard dev port)
    // In a real app, this base URL should come from config.
    private string GetFileUrl()
    {
        if (Document == null) return string.Empty;
        // Point to the API download endpoint
        return $"https://localhost:7148/api/documents/{Document.Id}/download";
    }
}

<style>
    .file-thumbnail {
        width: 100px;
        height: 120px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 5px;
        text-align: center;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        background: #f8f9fa;
        overflow: hidden;
    }

    .file-thumbnail:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .thumbnail-img {
        width: 100%;
        height: 80px;
        object-fit: cover;
        border-radius: 4px;
    }

    .pdf-icon, .unknown-icon {
        width: 100%;
        height: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        font-size: 2rem;
    }
    
    .unknown-icon {
        color: #6c757d;
    }

    .file-ext {
        font-size: 0.8rem;
        font-weight: bold;
        margin-top: 5px;
    }

    .file-name {
        font-size: 0.75rem;
        margin-top: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .file-modal-content {
        background-color: #f8f9fa;
        height: 90vh;
    }

    .file-modal-body {
        height: calc(90vh - 60px);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pdf-viewer {
        width: 100%;
        height: 100%;
        border: none;
    }
</style>
