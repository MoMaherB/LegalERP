@page "/cases/new"
@page "/cases/edit/{id:guid}"
@using LegalERP.Application.Cases
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CaseApiClient CaseApi
@inject NavigationManager NavManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer

<PageTitle>@(IsEditMode ? Loc["EditCase"] : Loc["AddNewCase"])</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@(IsEditMode ? Loc["EditCase"] : Loc["AddNewCase"])</h1>
    <a href="/cases" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
</div>

@if (isLoading)
{
    <p>@Loc["LoadingCaseInfo"]</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="glass-card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">@Loc["CaseNumber"] *</label>
                        <InputText class="form-control" @bind-Value="model.CaseNumber" placeholder="@Loc["CaseNumberPlaceholder"]" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">@Loc["TitleSubject"] *</label>
                        <InputText class="form-control" @bind-Value="model.Title" placeholder="@Loc["TitleSubjectPlaceholder"]" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">@Loc["CaseType"] *</label>
                        <InputSelect class="form-select" @bind-Value="model.CaseType">
                            @foreach (var type in Enum.GetValues<CaseType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Loc["Status"] *</label>
                        <InputSelect class="form-select" @bind-Value="model.Status">
                            @foreach (var status in Enum.GetValues<CaseStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>
                    @if (model.Status == CaseStatus.Closed)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@Loc["Outcome"] *</label>
                            <InputSelect class="form-select" @bind-Value="model.Outcome">
                                <option value="">@Loc["SelectOutcome"]</option>
                                @foreach (var outcome in Enum.GetValues<CaseOutcome>())
                                {
                                    <option value="@outcome">@outcome</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Loc["FilingDate"]</label>
                            <InputDate class="form-control" @bind-Value="model.FilingDate" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-5">
                            <label class="form-label">@Loc["FilingDate"]</label>
                            <InputDate class="form-control" @bind-Value="model.FilingDate" />
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label">@Loc["CourtName"]</label>
                        <InputText class="form-control" @bind-Value="model.CourtName" placeholder="@Loc["CourtNamePlaceholder"]" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Loc["JudgeName"]</label>
                        <InputText class="form-control" @bind-Value="model.JudgeName" placeholder="@Loc["JudgeNamePlaceholder"]" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">@Loc["NotesRemarks"]</label>
                        <InputTextArea class="form-control" rows="4" @bind-Value="model.Notes" placeholder="@Loc["NotesRemarksPlaceholder"]" />
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-3">@errorMessage</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                @(isSubmitting ? Loc["Saving"] : (IsEditMode ? Loc["SaveChanges"] : Loc["CreateCase"]))
            </button>
            <a href="/cases" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;
    private CaseFormModel model = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            var existing = await CaseApi.GetByIdAsync(Id!.Value);
            if (existing != null)
            {
                model = new CaseFormModel
                {
                    CaseNumber = existing.CaseNumber,
                    Title = existing.Title,
                    CaseType = existing.CaseType,
                    Status = existing.Status,
                    Outcome = existing.Outcome,
                    FilingDate = existing.FilingDate,
                    CourtName = existing.CourtName,
                    JudgeName = existing.JudgeName,
                    Notes = existing.Notes
                };
            }
            else
            {
                errorMessage = "Case not found.";
            }
        }
        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(model.CaseNumber) || string.IsNullOrWhiteSpace(model.Title))
        {
            errorMessage = "Case Number and Title are required.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            if (IsEditMode)
            {
                var updateDto = new UpdateCaseDto(
                    model.CaseNumber,
                    model.Title,
                    model.CaseType,
                    model.Status,
                    model.Outcome,
                    model.FilingDate,
                    model.CourtName,
                    model.JudgeName,
                    model.Notes
                );
                await CaseApi.UpdateAsync(Id!.Value, updateDto);
                NavManager.NavigateTo($"/cases/{Id.Value}");
            }
            else
            {
                var createDto = new CreateCaseDto(
                    model.CaseNumber,
                    model.Title,
                    model.CaseType,
                    model.Status,
                    model.Outcome,
                    model.FilingDate,
                    model.CourtName,
                    model.JudgeName,
                    model.Notes
                );
                var created = await CaseApi.CreateAsync(createDto);
                if (created != null)
                {
                    NavManager.NavigateTo($"/cases/{created.Id}");
                }
                else
                {
                    NavManager.NavigateTo("/cases");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to save case: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CaseFormModel
    {
        public string CaseNumber { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public CaseType CaseType { get; set; } = CaseType.Civil;
        public CaseStatus Status { get; set; } = CaseStatus.Active;
        public CaseOutcome? Outcome { get; set; }
        public DateOnly? FilingDate { get; set; }
        public string? CourtName { get; set; }
        public string? JudgeName { get; set; }
        public string? Notes { get; set; }
    }
}
