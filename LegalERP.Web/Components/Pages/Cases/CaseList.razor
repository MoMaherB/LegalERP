@page "/cases"
@using LegalERP.Application.Cases
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CaseApiClient CaseApi
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.Toast.IToastService ToastService
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer

<PageTitle>@Loc["CasesManagement"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="ios-title mb-0">@Loc["CasesManagement"]</h1>
    <AuthorizeView Roles="SuperAdmin,Admin,Editor">
        <Authorized>
            <a href="/cases/new" class="ios-btn ios-btn-primary text-decoration-none">
                <i class="fa-solid fa-plus me-1"></i> @Loc["AddNewCase"]
            </a>
        </Authorized>
    </AuthorizeView>
</div>

<!-- Search & Filter Controls -->
<div class="ios-widget-card mb-4 p-3 p-md-4">
    <div class="row g-3 align-items-end w-100 m-0">
        <div class="col-12 col-md-4 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["Search"]</label>
            <input type="text" class="ios-input" placeholder="@Loc["SearchPlaceholder"]" 
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        </div>
        <div class="col-6 col-md-3 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["CaseType"]</label>
            <select class="ios-select" @bind="selectedType">
                <option value="">@Loc["AllTypes"]</option>
                @foreach (var t in Enum.GetValues<CaseType>())
                {
                    <option value="@t">@Loc[t.ToString()]</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["Status"]</label>
            <select class="ios-select" @bind="selectedStatus">
                <option value="">@Loc["AllStatuses"]</option>
                @foreach (var s in Enum.GetValues<CaseStatus>())
                {
                    <option value="@s">@Loc[s.ToString()]</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-2 px-1 d-flex gap-2">
            <button class="ios-btn ios-btn-primary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
            <button class="ios-btn ios-btn-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
        </div>
    </div>
</div>

@if (cases is null)
{
    <p>@Loc["Loading"]</p>
}
else if (totalCount == 0)
{
    <div class="alert alert-info">
        @Loc["NoCasesFound"]
    </div>
}
else
{
    <div class="ios-table-container">
        <table class="ios-table">
            <thead>
                <tr>
                    <th>@Loc["CaseNumber"]</th>
                    <th>@Loc["TitleSubject"]</th>
                    <th class="d-none d-md-table-cell">@Loc["Type"]</th>
                    <th class="d-none d-lg-table-cell">@Loc["Court"]</th>
                    <th>@Loc["Status"]</th>
                    <th class="text-center">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in cases)
                {
                    <tr>
                        <td>
                            <strong>@c.CaseNumber</strong>
                            <div class="d-md-none mt-1">
                                <span class="ios-status-badge ios-status-gray" style="font-size: 0.7rem; padding: 2px 6px;">@Loc[c.CaseType.ToString()]</span>
                            </div>
                        </td>
                        <td>@c.Title</td>
                        <td class="d-none d-md-table-cell"><span class="ios-status-badge ios-status-gray">@Loc[c.CaseType.ToString()]</span></td>
                        <td class="d-none d-lg-table-cell">@(string.IsNullOrWhiteSpace(c.CourtName) ? "—" : c.CourtName)</td>
                        <td>
                            @if (c.Status == CaseStatus.Active)
                            {
                                <span class="ios-status-badge ios-status-amber">@Loc["Active"]</span>
                            }
                            else
                            {
                                @if (c.Outcome == CaseOutcome.Won)
                                {
                                    <span class="ios-status-badge ios-status-green">@Loc["ClosedWon"]</span>
                                }
                                else if (c.Outcome == CaseOutcome.Lost)
                                {
                                    <span class="ios-status-badge ios-status-red">@Loc["ClosedLost"]</span>
                                }
                                else if (c.Outcome == CaseOutcome.Settled)
                                {
                                    <span class="ios-status-badge ios-status-blue">@Loc["ClosedSettled"]</span>
                                }
                                else
                                {
                                    <span class="ios-status-badge ios-status-green">@Loc["Closed"]</span>
                                }
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                <a href="/cases/@c.Id" class="ios-btn ios-btn-info text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["View"]</a>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <a href="/cases/edit/@c.Id" class="ios-btn ios-btn-secondary text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["Edit"]</a>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <button class="ios-btn ios-btn-danger m-0" style="padding: 4px 8px; font-size: 0.8rem;" @onclick="() => DeleteCase(c.Id)">@Loc["Delete"]</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (totalCount > 0)
    {
        var startItem = (currentPage - 1) * pageSize + 1;
        var endItem = Math.Min(currentPage * pageSize, totalCount);

        <div class="row align-items-center g-2 mt-3 px-1 py-2">
            <div class="col-12 col-md-4 text-center text-md-start">
                <span class="ios-details text-muted small">
                    @Loc["Showing"] <strong>@startItem</strong> @Loc["To"] <strong>@endItem</strong> @Loc["Of"] <strong>@totalCount</strong> @Loc["Cases"]
                </span>
            </div>

            <div class="col-12 col-md-4 d-flex justify-content-center">
                <div class="ios-pagination-group" role="group" aria-label="Pagination">
                    <button type="button"
                            class="ios-pagination-btn pagination-prev"
                            disabled="@(!hasPreviousPage)"
                            @onclick="() => GoToPage(currentPage - 1)">
                        <i class="fa-solid fa-chevron-left rtl-flip"></i>
                        <span>@Loc["Previous"]</span>
                    </button>

                    <span class="ios-pagination-indicator pagination-indicator">
                        @Loc["Page"] @currentPage / @Math.Max(1, totalPages)
                    </span>

                    <button type="button"
                            class="ios-pagination-btn pagination-next"
                            disabled="@(!hasNextPage)"
                            @onclick="() => GoToPage(currentPage + 1)">
                        <span>@Loc["Next"]</span>
                        <i class="fa-solid fa-chevron-right rtl-flip"></i>
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-4 d-flex justify-content-center justify-content-md-end align-items-center gap-1">
                <label class="ios-details text-muted mb-0 small">@Loc["RowsPerPage"]:</label>
                <select class="ios-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.8rem; height: 28px;" value="@pageSize" @onchange="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    }
}

@code {
    private List<CaseDto>? cases;
    private string? searchTerm;
    private CaseType? selectedType;
    private CaseStatus? selectedStatus;

    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int totalPages = 1;
    private bool hasPreviousPage => currentPage > 1;
    private bool hasNextPage => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch(1);
    }

    private Task PerformSearch() => PerformSearch(1);

    private async Task PerformSearch(int page)
    {
        currentPage = Math.Max(1, page);
        var paged = string.IsNullOrWhiteSpace(searchTerm) && !selectedType.HasValue && !selectedStatus.HasValue
            ? await CaseApi.GetPagedAsync(currentPage, pageSize)
            : await CaseApi.SearchPagedAsync(searchTerm, selectedType, selectedStatus, currentPage, pageSize);

        cases = paged.Items;
        totalCount = paged.TotalCount;
        currentPage = paged.PageNumber;
        pageSize = paged.PageSize;
        totalPages = paged.TotalPages;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            await PerformSearch(1);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages) || page == currentPage)
            return;
        await PerformSearch(page);
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        selectedType = null;
        selectedStatus = null;
        currentPage = 1;
        await PerformSearch(1);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch(1);
        }
    }

    private async Task DeleteCase(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["DeleteCaseConfirm"].Value);
        if (confirmed)
        {
            await CaseApi.DeleteAsync(id);
            ToastService.ShowSuccess(Loc["CaseDeleted"].Value);
            var targetPage = (cases?.Count == 1 && currentPage > 1) ? currentPage - 1 : currentPage;
            await PerformSearch(targetPage);
        }
    }
}



