@page "/cases"
@using LegalERP.Application.Cases
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CaseApiClient CaseApi
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer

<PageTitle>@Loc["CasesManagement"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Loc["CasesManagement"]</h1>
    <a href="/cases/new" class="btn btn-primary">@Loc["AddNewCase"]</a>
</div>

<!-- Search & Filter Controls -->
<div class="glass-card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label font-weight-bold">@Loc["Search"]</label>
                <input type="text" class="form-control" placeholder="@Loc["SearchPlaceholder"]" 
                       @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            </div>
            <div class="col-md-3">
                <label class="form-label font-weight-bold">@Loc["CaseType"]</label>
                <select class="form-select" @bind="selectedType">
                    <option value="">@Loc["AllTypes"]</option>
                    @foreach (var t in Enum.GetValues<CaseType>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label font-weight-bold">@Loc["Status"]</label>
                <select class="form-select" @bind="selectedStatus">
                    <option value="">@Loc["AllStatuses"]</option>
                    @foreach (var s in Enum.GetValues<CaseStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-secondary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
                <button class="btn btn-outline-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
            </div>
        </div>
    </div>
</div>

@if (cases is null)
{
    <p>@Loc["Loading"]</p>
}
else if (cases.Count == 0)
{
    <div class="alert alert-info">
        @Loc["NoCasesFound"]
    </div>
}
else
{
    <table class="table table-hover align-middle table-glass">
        <thead>
            <tr>
                <th>@Loc["CaseNumber"]</th>
                <th>@Loc["TitleSubject"]</th>
                <th>@Loc["Type"]</th>
                <th>@Loc["Court"]</th>
                <th>@Loc["Status"]</th>
                <th>@Loc["FilingDate"]</th>
                <th>@Loc["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in cases)
            {
                <tr>
                    <td><strong>@c.CaseNumber</strong></td>
                    <td>@c.Title</td>
                    <td><span class="badge bg-secondary">@c.CaseType</span></td>
                    <td>@(string.IsNullOrWhiteSpace(c.CourtName) ? "—" : c.CourtName)</td>
                    <td>
                        @if (c.Status == CaseStatus.Active)
                        {
                            <span class="badge bg-warning text-dark">@Loc["Active"]</span>
                        }
                        else
                        {
                            @if (c.Outcome == CaseOutcome.Won)
                            {
                                <span class="badge bg-success">@Loc["ClosedWon"]</span>
                            }
                            else if (c.Outcome == CaseOutcome.Lost)
                            {
                                <span class="badge bg-danger">@Loc["ClosedLost"]</span>
                            }
                            else if (c.Outcome == CaseOutcome.Settled)
                            {
                                <span class="badge bg-info text-dark">@Loc["ClosedSettled"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Loc["Closed"]</span>
                            }
                        }
                    </td>
                    <td>@(c.FilingDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>
                        <a href="/cases/@c.Id" class="btn btn-sm btn-info me-1">@Loc["View"]</a>
                        <a href="/cases/edit/@c.Id" class="btn btn-sm btn-secondary me-1">@Loc["Edit"]</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCase(c.Id)">@Loc["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CaseDto>? cases;
    private string? searchTerm;
    private CaseType? selectedType;
    private CaseStatus? selectedStatus;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm) && !selectedType.HasValue && !selectedStatus.HasValue)
        {
            cases = await CaseApi.GetAllAsync();
        }
        else
        {
            cases = await CaseApi.SearchAsync(searchTerm, selectedType, selectedStatus);
        }
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        selectedType = null;
        selectedStatus = null;
        await PerformSearch();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task DeleteCase(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this case? This action cannot be undone.");
        if (confirmed)
        {
            await CaseApi.DeleteAsync(id);
            await PerformSearch();
        }
    }
}
