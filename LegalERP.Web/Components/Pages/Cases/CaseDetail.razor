@page "/cases/{Id:guid}"
@using LegalERP.Application.Cases
@using LegalERP.Domain.Enums
@using LegalERP.Web.Components.Pages.Cases.Sections
@using LegalERP.Web.Components.Shared
@using LegalERP.Web.Services
@using LegalERP.Web.Services.Toast
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject CaseApiClient CaseApi
@inject IToastService ToastService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> Loc
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>@Loc["CaseDetails"] - @(caseDto?.CaseNumber ?? Loc["Loading"].Value)</PageTitle>

@if (caseDto is null)
{
    @if (notFound)
    {
        <div class="alert alert-warning">
            @Loc["CaseNotFound"] <a href="/cases">@Loc["Back"]</a>
        </div>
    }
    else
    {
        <p>@Loc["Loading"]</p>
    }
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/cases" class="ios-btn ios-btn-secondary me-2 text-decoration-none">@Loc["Back"]</a>
            @if (_canEdit)
            {
                <a href="/cases/edit/@caseDto.Id" class="ios-btn ios-btn-primary me-2 text-decoration-none">@Loc["Edit"]</a>
            }
            @if (_canDelete)
            {
                <button class="ios-btn ios-btn-danger" @onclick="DeleteCase">@Loc["Delete"]</button>
            }
        </div>
    </div>

    <div class="ios-widget-card mb-4 p-4">
        <div class="d-flex flex-column align-items-start mb-4 gap-2">
            <h3 class="ios-title mb-0" style="font-size: 1.5rem;">@caseDto.Title</h3>
            <div class="d-flex gap-2">
                <span class="ios-status-badge ios-status-gray fs-6">@Loc[caseDto.CaseType.ToString()]</span>
                @if (caseDto.Status == CaseStatus.Active)
                {
                    <span class="ios-status-badge ios-status-amber fs-6">@Loc["Active"]</span>
                }
                else
                {
                    <span class="ios-status-badge ios-status-green fs-6">@Loc["Closed"]</span>
                    @if (caseDto.Outcome == CaseOutcome.Won)
                    {
                        <span class="ios-status-badge ios-status-green fs-6">@Loc["ClosedWon"]</span>
                    }
                    else if (caseDto.Outcome == CaseOutcome.Lost)
                    {
                        <span class="ios-status-badge ios-status-red fs-6">@Loc["ClosedLost"]</span>
                    }
                    else if (caseDto.Outcome == CaseOutcome.Settled)
                    {
                        <span class="ios-status-badge ios-status-blue fs-6">@Loc["ClosedSettled"]</span>
                    }
                }
            </div>
        </div>
        <div>
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>@Loc["CaseNumber"]:</strong>
                    <p class="fs-5 text-primary mb-0">@caseDto.CaseNumber</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(caseDto.CourtName))
                {
                    <div class="col-md-4">
                        <strong>@Loc["CourtName"]:</strong>
                        <p class="mb-0">@caseDto.CourtName</p>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(caseDto.JudgeName))
                {
                    <div class="col-md-4">
                        <strong>@Loc["JudgeName"]:</strong>
                        <p class="mb-0">@caseDto.JudgeName</p>
                    </div>
                }
                @if (caseDto.FilingDate.HasValue)
                {
                    <div class="col-md-4">
                        <strong>@Loc["FilingDate"]:</strong>
                        <p class="mb-0">@caseDto.FilingDate.Value.ToString("yyyy-MM-dd")</p>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(caseDto.Notes))
                {
                    <div class="col-12 mt-3">
                        <strong>@Loc["NotesRemarks"]:</strong>
                        <p class="border p-3 rounded bg-light mb-0" style="white-space: pre-wrap;">@caseDto.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Parties Section (Defendants vs Victims / Client vs Opponent) ── *@
    <CasePartiesSection Case="caseDto"
                        CanEdit="_canEdit"
                        CanDelete="_canDelete"
                        OnChanged="LoadCase" />

    @* ── Legal Memos & Briefs Section (المذكرات القانونية) ── *@
    <CaseMemosSection Case="caseDto"
                      CanEdit="_canEdit"
                      CanDelete="_canDelete"
                      OnChanged="LoadCase" />

    @* ── Hearings & Postponements (جلسات المحكمة وتسلسل التأجيلات) ── *@
    <CaseHearingsSection Case="caseDto"
                         CanEdit="_canEdit"
                         CanDelete="_canDelete"
                         OnChanged="LoadCase" />

    @* ── Case Documents / Files (With Custom Document Titles) ── *@
    <EntityDocumentsSection OwnerType="case"
                            OwnerId="caseDto.Id"
                            TitleKey="CaseDocuments"
                            EmptyMessageKey="NoCaseDocuments"
                            CanEdit="_canEdit"
                            CanDelete="_canDelete" />

    <AuthorizeView Roles="SuperAdmin,Admin">
        <Authorized>
            <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
                <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["Financials"]</h3>
            </div>
            <div class="ios-widget-card d-block w-100 mb-5">
                <div class="p-4 w-100">
                    <SharedFinancials OwnerId="caseDto.Id" OwnerType="case" />
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CaseDto? caseDto;
    private bool notFound;
    private bool _canEdit;
    private bool _canDelete;
    private Guid _lastLoadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _lastLoadedId)
        {
            _lastLoadedId = Id;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _canEdit = user.IsInRole("SuperAdmin") || user.IsInRole("Admin") || user.IsInRole("Editor");
            _canDelete = user.IsInRole("SuperAdmin") || user.IsInRole("Admin") || user.IsInRole("Editor");
            await LoadCase();
        }
    }

    private async Task LoadCase()
    {
        caseDto = await CaseApi.GetByIdAsync(Id);
        notFound = caseDto is null;
    }

    private async Task DeleteCase()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteCase"].Value);
        if (confirmed)
        {
            await CaseApi.DeleteAsync(Id);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            NavManager.NavigateTo("/cases");
        }
    }
}
