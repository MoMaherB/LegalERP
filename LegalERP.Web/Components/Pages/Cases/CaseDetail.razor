@page "/cases/{id:guid}"
@using LegalERP.Application.Cases
@using LegalERP.Application.Clients
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CaseApiClient CaseApi
@inject CompanyApiClient CompanyApi
@inject ClientApiClient ClientApi
@inject MockAuthService Auth
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@Loc["CaseDetails"] - @(caseDto?.CaseNumber ?? Loc["Loading"].Value)</PageTitle>

@if (caseDto is null)
{
    @if (notFound)
    {
        <div class="alert alert-warning">
            Case not found. <a href="/cases">Back to Cases</a>
        </div>
    }
    else
    {
        <p>Loading case details...</p>
    }
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/cases" class="ios-btn ios-btn-secondary me-2 text-decoration-none">@Loc["Back"]</a>
            <a href="/cases/edit/@caseDto.Id" class="ios-btn ios-btn-primary me-2 text-decoration-none">@Loc["Edit"]</a>
        </div>
        <button class="ios-btn ios-btn-danger" @onclick="DeleteCase">@Loc["Delete"]</button>
    </div>

    <div class="ios-widget-card mb-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="ios-title mb-0" style="font-size: 1.5rem;">@caseDto.Title</h3>
            <div class="d-flex gap-2 align-items-center">
                <span class="ios-status-badge ios-status-gray fs-6">@Loc[caseDto.CaseType.ToString()]</span>
                @if (caseDto.Status == CaseStatus.Active)
                {
                    <span class="ios-status-badge ios-status-amber fs-6">@Loc["Active"]</span>
                }
                else
                {
                    <span class="ios-status-badge ios-status-green fs-6">@Loc["Closed"]</span>
                    @if (caseDto.Outcome == CaseOutcome.Won)
                    {
                        <span class="ios-status-badge ios-status-green fs-6">@Loc["ClosedWon"]</span>
                    }
                    else if (caseDto.Outcome == CaseOutcome.Lost)
                    {
                        <span class="ios-status-badge ios-status-red fs-6">@Loc["ClosedLost"]</span>
                    }
                    else if (caseDto.Outcome == CaseOutcome.Settled)
                    {
                        <span class="ios-status-badge ios-status-blue fs-6">@Loc["ClosedSettled"]</span>
                    }
                }
            </div>
        </div>
        <div>
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>@Loc["CaseNumber"]:</strong>
                    <p class="fs-5 text-primary mb-0">@caseDto.CaseNumber</p>
                </div>
                <div class="col-md-4">
                    <strong>@Loc["CourtName"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(caseDto.CourtName) ? "—" : caseDto.CourtName)</p>
                </div>
                <div class="col-md-4">
                    <strong>@Loc["JudgeName"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(caseDto.JudgeName) ? "—" : caseDto.JudgeName)</p>
                </div>
                <div class="col-md-4">
                    <strong>@Loc["FilingDate"]:</strong>
                    <p class="mb-0">@(caseDto.FilingDate?.ToString("yyyy-MM-dd") ?? "—")</p>
                </div>
                <div class="col-12 mt-3">
                    <strong>@Loc["NotesRemarks"]:</strong>
                    <p class="border p-3 rounded bg-light mb-0">
                        @(string.IsNullOrWhiteSpace(caseDto.Notes) ? Loc["NoNotes"].Value : caseDto.Notes)
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ── Parties Section (Defendants vs Victims / Client vs Opponent) ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["CaseParties"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddPartyForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddPartyForm ? Loc["Cancel"].Value : Loc["AddParty"].Value)
        </button>
    </div>

    @if (showAddPartyForm)
    {
        <div class="ios-widget-card mb-4" style="border: 1px solid rgba(52, 211, 153, 0.3);">
            <div class="p-4">
                <h5 class="ios-title text-success mb-3" style="font-size: 1.2rem;">@Loc["AddCasePartyFromRegistry"]</h5>
                <div class="row g-3">
                    @* ── Client Quick-Search Selector or Manual Name ── *@
                    <div class="col-md-6">
                        @if (newPartyClientStatus == "client")
                        {
                            <label class="form-label ios-details fw-bold">@Loc["SearchClientByName"]</label>
                            <input class="ios-input" @bind="clientSearchTerm" @bind:event="oninput"
                                   @onkeyup="HandleClientSearch" placeholder="@Loc["TypeClientNamePlaceholder"]" />
                            @if (clientSearchResults != null)
                            {
                                <div class="list-group mt-1 shadow-sm" style="max-height:220px; overflow-y:auto; position:relative; z-index:100;">
                                    @if (clientSearchResults.Count > 0)
                                    {
                                        @foreach (var c in clientSearchResults)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action @(selectedClientId == c.Id ? "active" : "")"
                                                    @onclick="() => SelectClient(c)">
                                                <strong>@c.FullName</strong>
                                                @if (!string.IsNullOrWhiteSpace(c.NationalIdNumber))
                                                {
                                                    <span class="ms-1 text-muted">(ID: @c.NationalIdNumber)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.PhoneNumber))
                                                {
                                                    <small class="ms-2 text-muted">📞 @c.PhoneNumber</small>
                                                }
                                            </button>
                                        }
                                    }
                                    <a href="/clients/new" class="list-group-item list-group-item-action list-group-item-warning text-center">
                                        <strong>➕ @Loc["ClientNotFoundAddNew"]</strong>
                                    </a>
                                </div>
                            }
                            @if (selectedClientId.HasValue)
                            {
                                <div class="alert alert-success mt-2 mb-0 py-2 d-flex justify-content-between align-items-center">
                                    <span>✅ @Loc["Selected"]: <strong>@selectedClientName</strong></span>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearClientSelection">@Loc["Clear"]</button>
                                </div>
                            }
                        }
                        else
                        {
                            <label class="form-label ios-details fw-bold">@Loc["PartyName"] *</label>
                            <input class="ios-input" @bind="manualOpponentName" placeholder="@Loc["PartyName"]" />
                        }
                    </div>

                    <div class="col-md-3">
                        <label class="form-label ios-details fw-bold">@Loc["PartyPosition"]</label>
                        <select class="ios-select" @bind="newPartyRole">
                            @if (caseDto.CaseType == CaseType.Criminal)
                            {
                                <option value="@PartyRole.Defendant">@Loc["DefendantCriminal"]</option>
                                <option value="@PartyRole.Victim">@Loc["VictimCriminal"]</option>
                            }
                            else
                            {
                                <option value="@PartyRole.Defendant">@Loc["DefendantCivil"]</option>
                                <option value="@PartyRole.Victim">@Loc["PlaintiffCivil"]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label ios-details fw-bold">@Loc["ClientStatus"]</label>
                        <select class="ios-select" @bind="newPartyClientStatus">
                            <option value="client">@Loc["OurClientGreen"]</option>
                            <option value="opponent">@Loc["OpponentRed"]</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label ios-details fw-bold">@Loc["PartyNotes"]</label>
                        <input class="ios-input" @bind="newPartyNotes" placeholder="@Loc["PartyNotesPlaceholder"]" />
                    </div>

                    <div class="col-12">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="AddParty" disabled="@isSavingParty">
                            @(isSavingParty ? Loc["Saving"].Value : Loc["SaveParty"].Value)
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddPartyForm">@Loc["Cancel"]</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(partyErrorMessage))
                {
                    <p class="text-danger mt-2 mb-0">@partyErrorMessage</p>
                }
            </div>
        </div>
    }

    @if (caseDto.Parties.Count == 0)
    {
        <div class="alert alert-light border mb-4" style="border-radius: 12px;">@Loc["NoPartiesRecorded"]</div>
    }
    else
    {
        <div class="ios-table-container mb-4">
            <table class="ios-table">
                <thead>
                    <tr>
                        <th>@Loc["PartyName"]</th>
                        <th>@Loc["LegalRole"]</th>
                        <th>@Loc["Representation"]</th>
                        <th>@Loc["NationalID"]</th>
                        <th>@Loc["PhoneNumber"]</th>
                        <th>@Loc["AttachedDocument"]</th>
                        <th>@Loc["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var party in caseDto.Parties)
                    {
                        <tr>
                            <td>
                                @if (party.ClientId.HasValue)
                                {
                                    <a href="/clients/@party.ClientId.Value" class="text-decoration-none fw-bold" style="color: #2c3e50;">
                                        @party.FullName
                                    </a>
                                }
                                else
                                {
                                    <strong>@party.FullName</strong>
                                }
                            </td>
                            <td>
                                <span class="ios-status-badge ios-status-gray">
                                    @if (party.Role == PartyRole.Defendant)
                                    {
                                        @(caseDto.CaseType == CaseType.Criminal ? Loc["DefendantCriminal"].Value : Loc["DefendantCivil"].Value)
                                    }
                                    else
                                    {
                                        @(caseDto.CaseType == CaseType.Criminal ? Loc["VictimCriminal"].Value : Loc["PlaintiffCivil"].Value)
                                    }
                                </span>
                            </td>
                            <td>
                                @if (party.IsOurClient)
                                {
                                    <span class="ios-status-badge ios-status-green">@Loc["OurClient"]</span>
                                }
                                else
                                {
                                    <span class="ios-status-badge ios-status-red">@Loc["Opponent"]</span>
                                }
                            </td>
                            <td>@(party.NationalIdNumber ?? "—")</td>
                            <td>@(party.PhoneNumber ?? "—")</td>
                            <td>
                                @if (party.Document != null)
                                {
                                    <FileThumbnail Document="party.Document" OwnerType="caseparty" OwnerId="party.Id" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <button class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeleteParty(party.Id)">@Loc["Delete"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ── Legal Memos & Briefs Section (المذكرات القانونية) ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["LegalMemos"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddMemoForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddMemoForm ? Loc["Cancel"].Value : Loc["AddLegalMemo"].Value)
        </button>
    </div>

    @if (showAddMemoForm)
    {
        <div class="ios-widget-card mb-4" style="border: 1px solid rgba(59, 130, 246, 0.3);">
            <div class="p-4">
                <h5 class="ios-title text-info mb-3" style="font-size: 1.2rem;">@Loc["AddLegalMemoBrief"]</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label ios-details fw-bold">@Loc["MemoTitle"]</label>
                        <input class="ios-input" @bind="newMemoTitle" placeholder="@Loc["MemoTitlePlaceholder"]" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label ios-details fw-bold">@Loc["MemoDate"]</label>
                        <input type="date" class="ios-input" @bind="newMemoDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label ios-details fw-bold">@Loc["MemoAttachedDocument"]</label>
                        <InputFile class="ios-input" OnChange="LoadMemoFile" accept=".pdf,.doc,.docx" />
                    </div>

                    <div class="col-12">
                        <label class="form-label ios-details fw-bold">@Loc["MemoContent"]</label>
                        <textarea class="ios-input" @bind="newMemoContent" rows="4" placeholder="@Loc["MemoContentPlaceholder"]"></textarea>
                    </div>

                    <div class="col-12">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="AddMemo" disabled="@isSavingMemo">
                            @(isSavingMemo ? Loc["Saving"].Value : Loc["SaveLegalMemo"].Value)
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddMemoForm">@Loc["Cancel"]</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(memoErrorMessage))
                {
                    <p class="text-danger mt-2 mb-0">@memoErrorMessage</p>
                }
            </div>
        </div>
    }

    @if (caseDto.Memos is null || caseDto.Memos.Count == 0)
    {
        <div class="alert alert-light border mb-4" style="border-radius: 12px;">@Loc["NoLegalMemos"]</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
            @foreach (var memo in caseDto.Memos)
            {
                <div class="col">
                    <div class="ios-widget-card h-100 d-flex flex-column">
                        <div class="ios-content d-flex flex-column h-100 justify-content-between p-4">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <strong class="ios-title mb-0" style="font-size: 1.1rem; color: #1d4ed8;">@memo.Title</strong>
                                    <span class="ios-status-badge ios-status-gray">📅 @memo.MemoDate.ToString("yyyy-MM-dd")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(memo.Content))
                                {
                                    <p class="text-dark border-start border-4 ps-3 py-1 mb-3" style="border-color: rgba(59, 130, 246, 0.5) !important; white-space: pre-wrap; font-size: 0.95rem;">@memo.Content</p>
                                }
                                else
                                {
                                    <p class="text-muted italic mb-3">No content recorded.</p>
                                }

                                @if (memo.Document != null)
                                {
                                    <div class="mt-2 p-3 rounded text-center" style="background: rgba(0,0,0,0.02);">
                                        <FileThumbnail Document="memo.Document" OwnerType="casememo" OwnerId="memo.Id" />
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top" style="border-color: rgba(0,0,0,0.05) !important;">
                                @if (memo.Document != null)
                                {
                                    <label class="ios-btn ios-btn-secondary mb-0" style="padding: 4px 10px; font-size: 0.85rem; cursor: pointer;">
                                        @Loc["UpdateFile"]
                                        <InputFile OnChange="@((e) => UpdateMemoFile(memo.Id, e))" style="display: none;" accept=".pdf,.doc,.docx" />
                                    </label>
                                }
                                else
                                {
                                    <div></div>
                                }
                                <button class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeleteMemo(memo.Id)">@Loc["DeleteMemo"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Hearings & Postponements (جلسات المحكمة وتسلسل التأجيلات) ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["HearingsAndPostponements"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddHearingForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddHearingForm ? Loc["Cancel"].Value : Loc["AddHearing"].Value)
        </button>
    </div>

    @if (showAddHearingForm)
    {
        <div class="ios-widget-card mb-4">
            <div class="p-4">
                <h5 class="ios-title text-primary mb-3" style="font-size: 1.2rem;">@Loc["RecordNewHearing"]</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label ios-details fw-bold">@Loc["HearingDateForm"]</label>
                        <input type="date" class="ios-input" @bind="newHearingDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label ios-details fw-bold">@Loc["HearingPurpose"]</label>
                        <input class="ios-input" @bind="newHearingPurpose" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label ios-details fw-bold">@Loc["HearingDecision"]</label>
                        <input class="ios-input" @bind="newHearingDecision" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label ios-details fw-bold">@Loc["HearingPostponement"]</label>
                        <input class="ios-input" @bind="newPostponementReason" />
                    </div>
                    <div class="col-12">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="SaveHearing" disabled="@isSavingHearing">
                            @(isSavingHearing ? Loc["Saving"].Value : Loc["SaveHearing"].Value)
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddHearingForm">@Loc["Cancel"]</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(hearingErrorMessage))
                {
                    <p class="text-danger mt-2 mb-0">@hearingErrorMessage</p>
                }
            </div>
        </div>
    }

    @if (caseDto.Hearings == null || caseDto.Hearings.Count == 0)
    {
        <div class="alert alert-light border" style="border-radius: 12px;">@Loc["NoHearings"]</div>
    }
    else
    {
        <div class="ios-table-container mb-4">
            <table class="ios-table">
                <thead>
                    <tr>
                        <th>@Loc["HearingDate"]</th>
                        <th>@Loc["Purpose"]</th>
                        <th>@Loc["JudgeDecision"]</th>
                        <th>@Loc["PostponementReason"]</th>
                        <th class="text-end">@Loc["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hearing in caseDto.Hearings)
                    {
                        <tr>
                            <td><strong>@hearing.HearingDate.ToString("yyyy-MM-dd")</strong></td>
                            <td>@hearing.Purpose</td>
                            <td>@hearing.JudgeDecision</td>
                            <td>@hearing.PostponementReason</td>
                            <td class="text-end">
                                <button class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeleteHearing(hearing.Id)">@Loc["Delete"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ── Case Documents / Files (With Custom Document Titles) ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["CaseDocuments"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddDocForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddDocForm ? Loc["Cancel"].Value : Loc["UploadDocument"].Value)
        </button>
    </div>

    @if (showAddDocForm)
    {
        <div class="ios-widget-card mb-4">
            <div class="p-4">
                <h5 class="ios-title text-primary mb-3" style="font-size: 1.2rem;">@Loc["UploadDocCustomTitle"]</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label ios-details fw-bold">@Loc["DocTitleDescription"]</label>
                        <input class="ios-input" @bind="newDocTitle" placeholder="@Loc["DocTitlePlaceholder"]" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label ios-details fw-bold">@Loc["DocFile"]</label>
                        <InputFile class="ios-input" OnChange="LoadDocFile" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                    </div>
                    <div class="col-12">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="UploadCaseDocument" disabled="@isUploadingDoc">
                            @(isUploadingDoc ? Loc["Saving"].Value : Loc["UploadSaveDoc"].Value)
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddDocForm">@Loc["Cancel"]</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(docErrorMessage))
                {
                    <p class="text-danger mt-2 mb-0">@docErrorMessage</p>
                }
            </div>
        </div>
    }

    @if (caseDocuments is null)
    {
        <p>Loading documents...</p>
    }
    else if (caseDocuments.Count == 0)
    {
        <div class="alert alert-light border" style="border-radius: 12px;">@Loc["NoCaseDocuments"]</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
            @foreach (var doc in caseDocuments)
            {
                <div class="col">
                    <div class="ios-widget-card h-100">
                        <div class="ios-content text-center d-flex flex-column align-items-center justify-content-between">
                            <h6 class="ios-title text-start w-100 text-truncate font-weight-bold" style="font-size: 1.1rem;" title="@doc.FileName">
                                @doc.FileName
                            </h6>
                            <div class="my-3 p-3 rounded w-100" style="background: rgba(0,0,0,0.02);">
                                <FileThumbnail Document="doc" OwnerType="case" OwnerId="caseDto.Id" />
                            </div>
                            <div class="mt-auto w-100 d-flex justify-content-between align-items-center border-top pt-3" style="border-color: rgba(0,0,0,0.05) !important;">
                                <small class="ios-details fw-bold text-muted">@((doc.FileSizeBytes / 1024.0).ToString("0.0")) KB</small>
                                <button class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeleteCaseDocument(doc.Id)">@Loc["Delete"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (Auth.IsAdmin)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
            <h3 class="ios-title mb-0" style="font-size: 1.4rem;">Financials (الماليات)</h3>
        </div>
        <div class="ios-widget-card mb-5">
            <div class="p-4">
                <SharedFinancials OwnerId="caseDto.Id" OwnerType="case" />
            </div>
        </div>
    }

}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CaseDto? caseDto;
    private List<LegalERP.Application.Companies.DocumentDto>? caseDocuments;
    private bool notFound;

    // Party State
    private bool showAddPartyForm;
    private PartyRole newPartyRole = PartyRole.Defendant;
    private string newPartyClientStatus = "client";
    private string? newPartyNotes;
    private bool isSavingParty;
    private string? partyErrorMessage;

    // Client Search State
    private string? clientSearchTerm;
    private List<ClientSummaryDto>? clientSearchResults;
    private bool showNoClientFound;
    private Guid? selectedClientId;
    private string? selectedClientName;

    // Memo State
    private bool showAddMemoForm;
    private string? newMemoTitle;
    private string? newMemoContent;
    private DateOnly newMemoDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private IBrowserFile? newMemoFile;
    private bool isSavingMemo;
    private string? memoErrorMessage;

    // Hearing State
    private bool showAddHearingForm;
    private DateOnly newHearingDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private string? newHearingPurpose;
    private string? newHearingDecision;
    private string? newPostponementReason;
    private bool isSavingHearing;
    private string? hearingErrorMessage;

    // General Document State
    private bool showAddDocForm;
    private string? newDocTitle;
    private IBrowserFile? newDocFile;
    private bool isUploadingDoc;
    private string? docErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnRoleChanged += StateHasChanged;
        await LoadCase();
    }

    public void Dispose()
    {
        Auth.OnRoleChanged -= StateHasChanged;
    }

    private async Task LoadCase()
    {
        caseDto = await CaseApi.GetByIdAsync(Id);
        if (caseDto is null)
        {
            notFound = true;
        }
        else
        {
            await LoadCaseDocuments();
        }
    }

    private async Task LoadCaseDocuments()
    {
        try
        {
            caseDocuments = await CompanyApi.GetDocumentsAsync("case", Id);
        }
        catch (Exception ex)
        {
            docErrorMessage = "Failed to load documents: " + ex.Message;
            caseDocuments = new List<LegalERP.Application.Companies.DocumentDto>();
        }
    }

    private void ToggleAddPartyForm()
    {
        showAddPartyForm = !showAddPartyForm;
        partyErrorMessage = null;
        ClearClientSelection();
        manualOpponentName = null;
        clientSearchTerm = null;
        clientSearchResults = null;
        showNoClientFound = false;
    }

    // --- Client Quick-Search ---

    private async Task HandleClientSearch(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(clientSearchTerm))
        {
            clientSearchResults = null;
            showNoClientFound = false;
            return;
        }

        var results = await ClientApi.SearchAsync(clientSearchTerm);
        clientSearchResults = results;
        showNoClientFound = results.Count == 0;
    }

    private void SelectClient(ClientSummaryDto client)
    {
        selectedClientId = client.Id;
        selectedClientName = string.IsNullOrWhiteSpace(client.NationalIdNumber) 
            ? client.FullName 
            : $"{client.FullName} (ID: {client.NationalIdNumber})";
        clientSearchResults = null;
        showNoClientFound = false;
        clientSearchTerm = client.FullName;
    }

    private void ClearClientSelection()
    {
        selectedClientId = null;
        selectedClientName = null;
        clientSearchTerm = null;
        clientSearchResults = null;
        showNoClientFound = false;
    }

    // --- Add Party (from Client) ---

    private string? manualOpponentName;

    private async Task AddParty()
    {
        if (newPartyClientStatus == "client" && !selectedClientId.HasValue)
        {
            partyErrorMessage = "You must select a Client from the search results. If the person is not in the system, click 'Add new client' to register them first.";
            return;
        }

        if (newPartyClientStatus == "opponent" && string.IsNullOrWhiteSpace(manualOpponentName))
        {
            partyErrorMessage = "You must enter the opponent's name.";
            return;
        }

        isSavingParty = true;
        partyErrorMessage = null;

        try
        {
            var fullName = newPartyClientStatus == "client" ? selectedClientName! : manualOpponentName!;
            var clientId = newPartyClientStatus == "client" ? selectedClientId : null;

            var dto = new CreateCasePartyDto(
                clientId,
                fullName,
                newPartyRole,
                newPartyClientStatus == "client",
                null,  // NationalIdNumber comes from Client record
                null,  // PhoneNumber comes from Client record
                newPartyNotes,
                null   // DocumentId — documents are on the Client record
            );

            await CaseApi.AddPartyAsync(Id, dto);

            showAddPartyForm = false;
            ClearClientSelection();
            manualOpponentName = null;
            newPartyClientStatus = "client";
            newPartyNotes = null;

            await LoadCase();
        }
        catch (Exception ex)
        {
            partyErrorMessage = "Failed to add party: " + ex.Message;
        }
        finally
        {
            isSavingParty = false;
        }
    }

    private async Task DeleteParty(Guid partyId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteParty"].Value);
        if (confirmed)
        {
            await CaseApi.DeletePartyAsync(Id, partyId);
            await LoadCase();
        }
    }

    // --- Case Memo Methods ---

    private void ToggleAddMemoForm()
    {
        showAddMemoForm = !showAddMemoForm;
        memoErrorMessage = null;
        newMemoTitle = null;
        newMemoContent = null;
        newMemoDate = DateOnly.FromDateTime(DateTime.UtcNow);
        newMemoFile = null;
    }

    private void LoadMemoFile(InputFileChangeEventArgs e)
    {
        newMemoFile = e.File;
    }

    private async Task AddMemo()
    {
        if (string.IsNullOrWhiteSpace(newMemoTitle))
        {
            memoErrorMessage = "Memo Title (عنوان المذكرة) is required.";
            return;
        }

        isSavingMemo = true;
        memoErrorMessage = null;

        try
        {
            Guid? docId = null;
            if (newMemoFile != null)
            {
                docId = await CompanyApi.UploadDocumentAsync("casememo", Guid.NewGuid(), newMemoFile);
            }

            var dto = new CreateCaseMemoDto(newMemoTitle, newMemoContent, newMemoDate, docId);
            await CaseApi.AddMemoAsync(Id, dto);

            showAddMemoForm = false;
            newMemoTitle = null;
            newMemoContent = null;
            newMemoDate = DateOnly.FromDateTime(DateTime.UtcNow);
            newMemoFile = null;

            await LoadCase();
        }
        catch (Exception ex)
        {
            memoErrorMessage = "Failed to add memo: " + ex.Message;
        }
        finally
        {
            isSavingMemo = false;
        }
    }

    private async Task UpdateMemoFile(Guid memoId, InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            
            var existingMemo = caseDto!.Memos!.First(m => m.Id == memoId);
            
            // Upload new file
            var newDocId = await CompanyApi.UploadDocumentAsync("casememo", memoId, file);
            
            var updateDto = new UpdateCaseMemoDto(
                existingMemo.Title, 
                existingMemo.Content, 
                existingMemo.MemoDate, 
                newDocId);
                
            await CaseApi.UpdateMemoAsync(Id, memoId, updateDto);
            
            // Reload case to see new doc
            caseDto = await CaseApi.GetByIdAsync(Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            memoErrorMessage = "Failed to update memo file: " + ex.Message;
        }
    }

    private async Task DeleteMemo(Guid memoId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteMemo"].Value);
        if (confirmed)
        {
            await CaseApi.DeleteMemoAsync(Id, memoId);
            await LoadCase();
        }
    }

    // --- Hearing Methods ---

    private void ToggleAddHearingForm()
    {
        showAddHearingForm = !showAddHearingForm;
        hearingErrorMessage = null;
    }

    private async Task SaveHearing()
    {
        isSavingHearing = true;
        hearingErrorMessage = null;

        try
        {
            var dto = new CreateCaseHearingDto(
                newHearingDate,
                newHearingPurpose,
                newHearingDecision,
                newPostponementReason
            );

            await CaseApi.AddHearingAsync(Id, dto);
            
            showAddHearingForm = false;
            newHearingPurpose = null;
            newHearingDecision = null;
            newPostponementReason = null;
            
            await LoadCase();
        }
        catch (Exception ex)
        {
            hearingErrorMessage = "Failed to record hearing: " + ex.Message;
        }
        finally
        {
            isSavingHearing = false;
        }
    }

    private async Task DeleteHearing(Guid hearingId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteHearing"].Value);
        if (confirmed)
        {
            await CaseApi.DeleteHearingAsync(Id, hearingId);
            await LoadCase();
        }
    }

    // --- Case Document Methods ---

    private void ToggleAddDocForm()
    {
        showAddDocForm = !showAddDocForm;
        docErrorMessage = null;
    }

    private void LoadDocFile(InputFileChangeEventArgs e)
    {
        newDocFile = e.File;
        if (string.IsNullOrWhiteSpace(newDocTitle))
        {
            newDocTitle = e.File.Name;
        }
    }

    private async Task UploadCaseDocument()
    {
        if (newDocFile == null)
        {
            docErrorMessage = "Please select a file to upload.";
            return;
        }

        isUploadingDoc = true;
        docErrorMessage = null;

        try
        {
            var docId = await CompanyApi.UploadDocumentAsync("case", Id, newDocFile);
            showAddDocForm = false;
            newDocTitle = null;
            newDocFile = null;
            await LoadCase();
        }
        catch (Exception ex)
        {
            docErrorMessage = "Failed to upload document: " + ex.Message;
        }
        finally
        {
            isUploadingDoc = false;
        }
    }

    private async Task DeleteCaseDocument(Guid docId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteDoc"].Value);
        if (confirmed)
        {
            await CompanyApi.DeleteDocumentAsync(docId);
            await LoadCase();
        }
    }

    private async Task DeleteCase()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this case? This action cannot be undone.");
        if (confirmed)
        {
            await CaseApi.DeleteAsync(Id);
            NavManager.NavigateTo("/cases");
        }
    }
}

