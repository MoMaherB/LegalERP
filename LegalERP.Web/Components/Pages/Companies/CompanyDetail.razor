@page "/companies/{Id:guid}"
@using LegalERP.Application.Companies
@using LegalERP.Application.Clients
@using LegalERP.Web.Services
@using LegalERP.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject CompanyApiClient CompanyApi
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject MockAuthService Auth
@rendermode InteractiveServer
@implements IDisposable

@if (company is null)
{
    <p>Loading...</p>
}
else
{
    <PageTitle>@company.CompanyName - Details</PageTitle>

    <div class="mb-4">
        <button class="btn btn-outline-secondary" @onclick="GoBack">Back to List</button>
        <a href="/companies/edit/@company.Id" class="btn btn-primary ms-2">Edit</a>
    </div>

    <h1>@company.CompanyName</h1>
    
    <div class="row">
        @* ── Company Info Card ── *@
        <div class="col-md-8">
            <div class="card mb-4 h-100">
                <div class="card-body">
                    <h5 class="card-title">Company Info</h5>
                    <dl class="row">
                        <dt class="col-sm-4">English Name</dt>
                        <dd class="col-sm-8">@(company.CompanyNameEn ?? "—")</dd>

                        <dt class="col-sm-4">Trade Name</dt>
                        <dd class="col-sm-8">@(company.TradeName ?? "—")</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@company.Category</dd>

                        <dt class="col-sm-4">Establishment Date</dt>
                        <dd class="col-sm-8">@(company.EstablishmentDate?.ToString("yyyy-MM-dd") ?? "—")</dd>

                        <dt class="col-sm-4">Registration Number</dt>
                        <dd class="col-sm-8">@(company.RegistrationNumber ?? "—")</dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@(company.Address ?? "—")</dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ── Incorporation Contract Card ── *@
        <div class="col-md-4">
            <div class="card mb-4 h-100">
                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                    <h5 class="card-title w-100 text-start">Incorporation Contract</h5>
                    @if (company.IncorporationDocument != null)
                    {
                        <div class="mb-2">
                            <FileThumbnail Document="company.IncorporationDocument" OwnerType="company" OwnerId="company.Id" />
                        </div>
                        <div class="mt-2 w-100">
                            <label class="form-label text-muted small">Replace Contract</label>
                            <InputFile class="form-control form-control-sm mb-2" OnChange="LoadIncorporationFile" accept=".pdf,.jpg,.jpeg,.png" />
                            @if (incorporationContractFile != null)
                            {
                                <button class="btn btn-sm btn-primary w-100" @onclick="UploadIncorporationContract" disabled="@isUploadingIncorporationContract">
                                    @(isUploadingIncorporationContract ? "Uploading..." : "Save New Contract")
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-2">No contract uploaded yet.</p>
                        <div class="w-100">
                            <InputFile class="form-control form-control-sm mb-2" OnChange="LoadIncorporationFile" accept=".pdf,.jpg,.jpeg,.png" />
                            @if (incorporationContractFile != null)
                            {
                                <button class="btn btn-sm btn-success w-100" @onclick="UploadIncorporationContract" disabled="@isUploadingIncorporationContract">
                                    @(isUploadingIncorporationContract ? "Uploading..." : "Upload Contract")
                                </button>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(incorporationContractErrorMessage))
                    {
                        <p class="text-danger small mt-2 mb-0">@incorporationContractErrorMessage</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Partners Section ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="mb-0">Partners</h3>
        <button class="btn btn-sm btn-success" @onclick="ToggleAddPartnerForm">
            @(showAddPartnerForm ? "Cancel" : "+ Add Partner")
        </button>
    </div>

    @if (showAddPartnerForm)
    {
        <div class="card mb-3 border-success">
            <div class="card-body">
                <h5 class="card-title text-success">Add Company Partner (from Clients Registry)</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Search Client by Name (بحث عن الموكل) *</label>
                        <input class="form-control" @bind="clientSearchTerm" @bind:event="oninput"
                               @onkeyup="HandleClientSearch" placeholder="Type client name to search..." />
                        @if (clientSearchResults != null)
                        {
                            <div class="list-group mt-1 shadow-sm" style="max-height:220px; overflow-y:auto; position:relative; z-index:100;">
                                @if (clientSearchResults.Count > 0)
                                {
                                    @foreach (var c in clientSearchResults)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action @(selectedClientId == c.Id ? "active" : "")"
                                                @onclick="() => SelectClient(c)">
                                            <strong>@c.FullName</strong>
                                            @if (!string.IsNullOrWhiteSpace(c.NationalIdNumber))
                                            {
                                                <span class="ms-1 text-muted">(ID: @c.NationalIdNumber)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(c.PhoneNumber))
                                            {
                                                <small class="ms-2 text-muted">📞 @c.PhoneNumber</small>
                                            }
                                        </button>
                                    }
                                }
                                <a href="/clients/new" class="list-group-item list-group-item-action list-group-item-warning text-center">
                                    <strong>➕ Client not found — Add new client (إضافة موكل جديد)</strong>
                                </a>
                            </div>
                        }
                        @if (selectedClientId.HasValue)
                        {
                            <div class="alert alert-success mt-2 mb-0 py-2 d-flex justify-content-between align-items-center">
                                <span>✅ Selected: <strong>@selectedClientName</strong></span>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearClientSelection">Clear</button>
                            </div>
                        }
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Ownership % (نسبة الملكية)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newPartnerOwnership" placeholder="e.g. 25.5" />
                    </div>

                    <div class="col-12 mt-3">
                        <button class="btn btn-success me-2" @onclick="AddPartner" disabled="@isSavingPartner">
                            @(isSavingPartner ? "Saving..." : "Save Partner")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ToggleAddPartnerForm">Cancel</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(partnerErrorMessage))
                {
                    <p class="text-danger mt-2">@partnerErrorMessage</p>
                }
            </div>
        </div>
    }

    @if (company.Partners.Count == 0)
    {
        <p class="text-muted">No partners recorded yet.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>National ID</th>
                    <th>Ownership %</th>
                    <th>ID Document</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var partner in company.Partners)
                {
                    <tr>
                        <td>@partner.FullName</td>
                        <td>@(partner.NationalIdNumber ?? "—")</td>
                        <td>@(partner.OwnershipPercentage?.ToString("0.00") ?? "—")%</td>
                        <td>
                            @if (partner.NationalIdDocument != null)
                            {
                                <FileThumbnail Document="partner.NationalIdDocument" OwnerType="partner" OwnerId="partner.Id" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeletePartner(partner.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ── Amendments Section ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="mb-0">Amendments</h3>
        <button class="btn btn-sm btn-success" @onclick="ToggleAddAmendmentForm">
            @(showAddAmendmentForm ? "Cancel" : "+ Add Amendment")
        </button>
    </div>

    @if (showAddAmendmentForm)
    {
        <div class="card mb-3 border-success">
            <div class="card-body">
                <h5 class="card-title text-success">New Amendment</h5>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Title (Leave blank for auto-generation)</label>
                        <input class="form-control" @bind="newAmendmentTitle" placeholder="@NextAmendmentPlaceholder" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" @bind="newAmendmentDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Amendment Contract</label>
                        <InputFile class="form-control" OnChange="LoadAmendmentFile" accept=".pdf,.jpg,.jpeg,.png" />
                    </div>
                    <div class="col-12 mt-3">
                        <button class="btn btn-success" @onclick="AddAmendment" disabled="@isSavingAmendment">
                            @(isSavingAmendment ? "Saving..." : "Save Amendment")
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(amendmentErrorMessage))
                {
                    <p class="text-danger mt-2">@amendmentErrorMessage</p>
                }
            </div>
        </div>
    }

    @if (company.Amendments.Count == 0)
    {
        <p class="text-muted">No amendments recorded yet.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Contract</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var amendment in company.Amendments.OrderBy(a => a.SequenceNumber))
                {
                    <tr>
                        <td>@amendment.SequenceNumber</td>
                        <td>@amendment.Title</td>
                        <td>@amendment.AmendmentDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (amendment.Document != null)
                            {
                                <FileThumbnail Document="amendment.Document" OwnerType="amendment" OwnerId="amendment.Id" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAmendment(amendment.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Auth.IsAdmin)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
            <h3 class="mb-0 text-success">Financials (الماليات)</h3>
        </div>
        <div class="card border-success mb-5">
            <div class="card-body">
                <SharedFinancials OwnerId="company.Id" OwnerType="company" />
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CompanyDto? company;

    // Incorporation Contract state
    private IBrowserFile? incorporationContractFile;
    private bool isUploadingIncorporationContract;
    private string? incorporationContractErrorMessage;

    private void LoadIncorporationFile(InputFileChangeEventArgs e)
    {
        incorporationContractFile = e.File;
        incorporationContractErrorMessage = null;
    }

    private async Task UploadIncorporationContract()
    {
        if (company == null || incorporationContractFile == null) return;

        isUploadingIncorporationContract = true;
        incorporationContractErrorMessage = null;

        try
        {
            var docId = await CompanyApi.UploadDocumentAsync("company", company.Id, incorporationContractFile);
            var updateDto = new UpdateCompanyDto(
                company.Category,
                company.CompanyName,
                company.CompanyNameEn,
                company.TradeName,
                company.EstablishmentDate,
                company.RegistrationNumber,
                company.Address,
                docId
            );
            await CompanyApi.UpdateAsync(company.Id, updateDto);

            incorporationContractFile = null;
            await LoadCompany();
        }
        catch (Exception ex)
        {
            incorporationContractErrorMessage = "Failed to upload contract: " + ex.Message;
        }
        finally
        {
            isUploadingIncorporationContract = false;
        }
    }

    private string NextAmendmentPlaceholder
    {
        get
        {
            if (company == null) return "عقد التعديل الأول";
            var nextSeq = company.Amendments.Count == 0 ? 1 : company.Amendments.Max(a => a.SequenceNumber) + 1;
            var ordinals = new[] { "الأول", "الثاني", "الثالث", "الرابع", "الخامس", "السادس", "السابع", "الثامن", "التاسع", "العاشر" };
            var ordinalStr = nextSeq <= 10 ? ordinals[nextSeq - 1] : nextSeq.ToString();
            return $"عقد التعديل {ordinalStr}";
        }
    }

    // Amendment state
    private bool showAddAmendmentForm;
    private string? newAmendmentTitle;
    private DateOnly? newAmendmentDate;
    private IBrowserFile? newAmendmentFile;
    private bool isSavingAmendment;
    private string? amendmentErrorMessage;

    // Partner state
    private bool showAddPartnerForm;
    private decimal? newPartnerOwnership;
    private bool isSavingPartner;
    private string? partnerErrorMessage;

    // Client Search state for Partner selection
    private string? clientSearchTerm;
    private List<ClientSummaryDto>? clientSearchResults;
    private Guid? selectedClientId;
    private string? selectedClientName;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnRoleChanged += StateHasChanged;
        await LoadCompany();
    }

    public void Dispose()
    {
        Auth.OnRoleChanged -= StateHasChanged;
    }

    private async Task LoadCompany()
    {
        company = await CompanyApi.GetByIdAsync(Id);
    }

    private void GoBack() => NavManager.NavigateTo("/companies");

    // ── Amendments ──

    private void ToggleAddAmendmentForm()
    {
        showAddAmendmentForm = !showAddAmendmentForm;
        amendmentErrorMessage = null;
        newAmendmentTitle = null;
        newAmendmentDate = null;
        newAmendmentFile = null;
    }

    private void LoadAmendmentFile(InputFileChangeEventArgs e)
    {
        newAmendmentFile = e.File;
    }

    private async Task AddAmendment()
    {
        amendmentErrorMessage = null;
        isSavingAmendment = true;

        try
        {
            var dto = new CreateCompanyAmendmentDto(newAmendmentTitle, newAmendmentDate, null);
            var result = await CompanyApi.AddAmendmentAsync(Id, dto);

            if (result != null && newAmendmentFile != null)
            {
                var docId = await CompanyApi.UploadDocumentAsync("amendment", result.Id, newAmendmentFile);
                var updateDto = new UpdateCompanyAmendmentDto(result.Title, result.AmendmentDate, docId);
                await CompanyApi.UpdateAmendmentAsync(Id, result.Id, updateDto);
            }

            showAddAmendmentForm = false;
            newAmendmentTitle = null;
            newAmendmentDate = null;
            newAmendmentFile = null;
            await LoadCompany();
        }
        catch (Exception ex)
        {
            amendmentErrorMessage = "Failed to add amendment: " + ex.Message;
        }
        finally
        {
            isSavingAmendment = false;
        }
    }

    private async Task DeleteAmendment(Guid amendmentId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this amendment?");
        if (confirmed)
        {
            await CompanyApi.DeleteAmendmentAsync(Id, amendmentId);
            await LoadCompany();
        }
    }

    // ── Partners ──

    private async Task HandleClientSearch(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(clientSearchTerm))
        {
            clientSearchResults = null;
            return;
        }

        clientSearchResults = await ClientApi.SearchAsync(clientSearchTerm);
    }

    private void SelectClient(ClientSummaryDto client)
    {
        selectedClientId = client.Id;
        selectedClientName = string.IsNullOrWhiteSpace(client.NationalIdNumber) 
            ? client.FullName 
            : $"{client.FullName} (ID: {client.NationalIdNumber})";
        clientSearchResults = null;
        clientSearchTerm = client.FullName;
    }

    private void ClearClientSelection()
    {
        selectedClientId = null;
        selectedClientName = null;
        clientSearchTerm = null;
        clientSearchResults = null;
    }

    private void ToggleAddPartnerForm()
    {
        showAddPartnerForm = !showAddPartnerForm;
        partnerErrorMessage = null;
        newPartnerOwnership = null;
        ClearClientSelection();
    }

    private async Task AddPartner()
    {
        partnerErrorMessage = null;

        if (!selectedClientId.HasValue)
        {
            partnerErrorMessage = "You must select a Client from the search results. If the person is not in the system, click 'Add new client' to register them first.";
            return;
        }

        isSavingPartner = true;

        try
        {
            var dto = new CreateCompanyPartnerDto(selectedClientId.Value, newPartnerOwnership);
            await CompanyApi.AddPartnerAsync(Id, dto);

            showAddPartnerForm = false;
            newPartnerOwnership = null;
            ClearClientSelection();
            await LoadCompany();
        }
        catch (Exception ex)
        {
            partnerErrorMessage = "Failed to add partner: " + ex.Message;
        }
        finally
        {
            isSavingPartner = false;
        }
    }

    private async Task DeletePartner(Guid partnerId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this partner?");
        if (confirmed)
        {
            await CompanyApi.DeletePartnerAsync(Id, partnerId);
            await LoadCompany();
        }
    }
}
