@page "/companies/{Id:guid}"
@using LegalERP.Web.Services.Toast
@inject IToastService ToastService
@using LegalERP.Application.Companies
@using LegalERP.Application.Clients
@using LegalERP.Web.Services
@using LegalERP.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject CompanyApiClient CompanyApi
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.Toast.IToastService ToastService
@inject IJSRuntime JS
@inject MockAuthService Auth
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer
@implements IDisposable

@if (company is null)
{
    <p>@Loc["Loading"]</p>
}
else
{
    <PageTitle>@company.CompanyName - @Loc["Details"]</PageTitle>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="ios-title mb-0">@company.CompanyName</h1>
        <div class="d-flex align-items-center gap-2">
            <button class="ios-btn ios-btn-secondary text-decoration-none m-0" @onclick="GoBack">@Loc["BackToList"]</button>
            <a href="/companies/edit/@company.Id" class="ios-btn ios-btn-primary text-decoration-none m-0">@Loc["Edit"]</a>
        </div>
    </div>
    
    <div class="row align-items-stretch mb-4">
        @* ── Company Info Card ── *@
        <div class="col-md-8">
            <div class="ios-widget-card h-100">
                <div class="p-4">
                    <h5 class="ios-title" style="font-size: 1.25rem;">@Loc["CompanyInfo"]</h5>
                    <dl class="row mt-3">
                        <dt class="col-sm-4 ios-details fw-bold">@Loc["Category"]</dt>
                        <dd class="col-sm-8 mb-3"><span class="ios-status-badge ios-status-gray">@Loc[company.Category.ToString()]</span></dd>

                        @if (!string.IsNullOrWhiteSpace(company.CompanyNameEn))
                        {
                            <dt class="col-sm-4 ios-details fw-bold">@Loc["EnglishName"]</dt>
                            <dd class="col-sm-8 mb-3">@company.CompanyNameEn</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(company.TradeName))
                        {
                            <dt class="col-sm-4 ios-details fw-bold">@Loc["TradeName"]</dt>
                            <dd class="col-sm-8 mb-3">@company.TradeName</dd>
                        }

                        @if (company.EstablishmentDate.HasValue)
                        {
                            <dt class="col-sm-4 ios-details fw-bold">@Loc["EstablishmentDate"]</dt>
                            <dd class="col-sm-8 mb-3">@company.EstablishmentDate.Value.ToString("yyyy-MM-dd")</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(company.RegistrationNumber))
                        {
                            <dt class="col-sm-4 ios-details fw-bold">@Loc["RegistrationNumber"]</dt>
                            <dd class="col-sm-8 mb-3">@company.RegistrationNumber</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(company.Address))
                        {
                            <dt class="col-sm-4 ios-details fw-bold">@Loc["Address"]</dt>
                            <dd class="col-sm-8 mb-3">@company.Address</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        @* ── Incorporation Contract Card ── *@
        <div class="col-md-4">
            <div class="ios-widget-card h-100">
                <div class="p-4 d-flex flex-column">
                    <h5 class="ios-title mb-3" style="font-size: 1.25rem;">@Loc["IncorporationContract"]</h5>
                    @if (company.IncorporationDocument != null)
                    {
                        <div class="mb-3 flex-grow-1">
                            <FileThumbnail Document="company.IncorporationDocument" OwnerType="company" OwnerId="company.Id" AllowReplace="true" OnReplace="HandleContractReplace" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4 flex-grow-1">@Loc["NoContractUploaded"]</p>
                        <InputFile class="ios-input mb-3" OnChange="LoadIncorporationFile" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                        @if (incorporationContractFile != null)
                        {
                            <button class="ios-btn ios-btn-primary w-100" @onclick="UploadIncorporationContract" disabled="@isUploadingIncorporationContract">
                                @(isUploadingIncorporationContract ? Loc["Uploading"].Value : Loc["UploadContract"].Value)
                            </button>
                        }
                    }

                </div>
            </div>
        </div>
    </div>

    @* ── Partners Section ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["Partners"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddPartnerForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddPartnerForm ? Loc["Cancel"] : Loc["AddPartner"])
        </button>
    </div>

    @if (showAddPartnerForm)
    {
        <div class="ios-widget-card mb-4" style="border: 1px solid rgba(52, 211, 153, 0.3);">
            <div class="p-4">
                <h5 class="ios-title text-success mb-3" style="font-size: 1.2rem;">@Loc["AddCompanyPartner"]</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label ios-details fw-bold">@Loc["SearchClientByName"] *</label>
                        <input class="ios-input" @bind="clientSearchTerm" @bind:event="oninput"
                               @onkeyup="HandleClientSearch" placeholder="@Loc["TypeClientNameSearch"]" />
                        @if (clientSearchResults != null)
                        {
                            <div class="list-group mt-2 shadow-sm" style="max-height:220px; overflow-y:auto; position:relative; z-index:100; border-radius: 12px;">
                                @if (clientSearchResults.Count > 0)
                                {
                                    @foreach (var c in clientSearchResults)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action border-0 @(selectedClientId == c.Id ? "active" : "")"
                                                @onclick="() => SelectClient(c)">
                                            <strong>@c.FullName</strong>
                                            @if (!string.IsNullOrWhiteSpace(c.NationalIdNumber))
                                            {
                                                <span class="ms-1 text-muted">(ID: @c.NationalIdNumber)</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(c.PhoneNumber))
                                            {
                                                <small class="ms-2 text-muted">📞 @c.PhoneNumber</small>
                                            }
                                        </button>
                                    }
                                }
                                <a href="/clients/new" class="list-group-item list-group-item-action list-group-item-warning border-0 text-center">
                                    <strong>➕ @Loc["ClientNotFoundAddNew"]</strong>
                                </a>
                            </div>
                        }
                        @if (selectedClientId.HasValue)
                        {
                            <div class="alert alert-success mt-3 mb-0 py-2 d-flex justify-content-between align-items-center" style="border-radius: 12px;">
                                <span>✅ @Loc["Selected"]: <strong>@selectedClientName</strong></span>
                                <button type="button" class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="ClearClientSelection">@Loc["Clear"]</button>
                            </div>
                        }
                    </div>

                    <div class="col-md-4">
                        <label class="form-label ios-details fw-bold">@Loc["OwnershipPercentage"]</label>
                        <input type="number" step="0.01" class="ios-input" @bind="newPartnerOwnership" placeholder="e.g. 25.5" />
                    </div>

                    <div class="col-12 mt-4">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="AddPartner" disabled="@isSavingPartner">
                            @(isSavingPartner ? Loc["Saving"] : Loc["SavePartner"])
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddPartnerForm">@Loc["Cancel"]</button>
                    </div>
                </div>

            </div>
        </div>
    }

    @if (company.Partners.Count == 0)
    {
        <div class="alert alert-light border mb-4" style="border-radius: 12px;">@Loc["NoPartnersRecorded"]</div>
    }
    else
    {
        <div class="ios-table-container mb-4">
            <table class="ios-table">
                <thead>
                    <tr>
                        <th>@Loc["Name"]</th>
                        <th>@Loc["NationalID"]</th>
                        <th>@Loc["OwnershipPercentage"]</th>
                        <th>@Loc["IDDocument"]</th>
                        <th>@Loc["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partner in company.Partners)
                    {
                        <tr>
                            <td><strong>@partner.FullName</strong></td>
                            <td>@(partner.NationalIdNumber ?? "—")</td>
                            <td>
                                @if (partner.OwnershipPercentage.HasValue)
                                {
                                    <span class="ios-status-badge ios-status-blue">@partner.OwnershipPercentage.Value.ToString("0.00")%</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (partner.NationalIdDocument != null)
                                {
                                    <FileThumbnail Document="partner.NationalIdDocument" OwnerType="partner" OwnerId="partner.Id" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <button class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeletePartner(partner.Id)">@Loc["Delete"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ── Amendments Section ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["Amendments"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddAmendmentForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddAmendmentForm ? Loc["Cancel"] : Loc["AddAmendment"])
        </button>
    </div>

    @if (showAddAmendmentForm)
    {
        <div class="ios-widget-card mb-4" style="border: 1px solid rgba(59, 130, 246, 0.3);">
            <div class="p-4">
                <h5 class="ios-title text-primary mb-3" style="font-size: 1.2rem;">@Loc["NewAmendment"]</h5>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label ios-details fw-bold">@Loc["TitleLeaveBlankAuto"]</label>
                        <input class="ios-input" @bind="newAmendmentTitle" placeholder="@NextAmendmentPlaceholder" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label ios-details fw-bold">@Loc["Date"]</label>
                        <input type="date" class="ios-input" @bind="newAmendmentDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label ios-details fw-bold">@Loc["AmendmentContract"]</label>
                        <InputFile class="ios-input" OnChange="LoadAmendmentFile" accept=".pdf,.jpg,.jpeg,.png" />
                    </div>
                    <div class="col-12 mt-4">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="AddAmendment" disabled="@isSavingAmendment">
                            @(isSavingAmendment ? Loc["Saving"] : Loc["SaveAmendment"])
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddAmendmentForm">@Loc["Cancel"]</button>
                    </div>
                </div>

            </div>
        </div>
    }

    @if (company.Amendments.Count == 0)
    {
        <div class="alert alert-light border mb-4" style="border-radius: 12px;">@Loc["NoAmendmentsRecorded"]</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
            @foreach (var amendment in company.Amendments.OrderBy(a => a.SequenceNumber))
            {
                <div class="col">
                    <div class="ios-widget-card h-100 p-3 d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="ios-status-badge ios-status-gray">#@amendment.SequenceNumber</span>
                            <span class="text-muted small">@(amendment.AmendmentDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                        </div>
                        <h6 class="fw-bold mb-2">@amendment.Title</h6>
                        
                        <div class="flex-grow-1">
                        @if (amendment.Document != null)
                        {
                            <FileThumbnail Document="amendment.Document" OwnerType="amendment" OwnerId="amendment.Id" AllowReplace="true" OnReplace="@(e => HandleAmendmentReplace(amendment.Id, e))" />
                        }
                        else
                        {
                            <div class="doc-card d-flex align-items-center justify-content-center bg-light text-muted" style="border:1px dashed #ccc; height:220px; border-radius:12px;">
                                @Loc["NoContractUploaded"]
                            </div>
                        }
                        </div>
                        <button class="ios-btn ios-btn-danger w-100 mt-2" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeleteAmendment(amendment.Id)">@Loc["Delete"]</button>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Company Documents Section (مستندات الشركة) ── *@
    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
        <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["CompanyDocuments"]</h3>
        <button class="ios-btn ios-btn-primary" @onclick="ToggleAddCompanyDocForm" style="padding: 6px 12px; font-size: 0.9rem;">
            @(showAddCompanyDocForm ? Loc["Cancel"].Value : Loc["UploadDocument"].Value)
        </button>
    </div>

    @if (showAddCompanyDocForm)
    {
        <div class="ios-widget-card mb-4">
            <div class="p-4">
                <h5 class="ios-title text-primary mb-3" style="font-size: 1.2rem;">@Loc["UploadDocCustomTitle"]</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label ios-details fw-bold">@Loc["DocTitleDescription"]</label>
                        <input class="ios-input" @bind="newCompanyDocTitle" placeholder="@Loc["DocTitlePlaceholder"]" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label ios-details fw-bold">@Loc["DocFile"]</label>
                        <InputFile class="ios-input" OnChange="LoadCompanyDocFile" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                    </div>
                    <div class="col-12">
                        <button class="ios-btn ios-btn-primary me-2" @onclick="UploadCompanyDocument" disabled="@isUploadingCompanyDoc">
                            @(isUploadingCompanyDoc ? Loc["Saving"].Value : Loc["UploadSaveDoc"].Value)
                        </button>
                        <button class="ios-btn ios-btn-secondary" @onclick="ToggleAddCompanyDocForm">@Loc["Cancel"]</button>
                    </div>
                </div>

            </div>
        </div>
    }

    @if (companyDocuments is null)
    {
        <p>@Loc["Loading"]</p>
    }
    else if (companyDocuments.Count == 0)
    {
        <div class="alert alert-light border" style="border-radius: 12px;">@Loc["NoCompanyDocuments"]</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
            @foreach (var doc in companyDocuments)
            {
                <div class="col">
                    <div class="d-flex flex-column h-100 gap-2">
                        <FileThumbnail Document="doc" OwnerType="companydoc" OwnerId="company.Id" AllowReplace="true" OnReplace="@(e => HandleCompanyDocumentReplace(doc.Id, e))" />
                        <div class="d-flex justify-content-between align-items-center px-1">
                            <small class="ios-details fw-bold text-muted">@((doc.FileSizeBytes / 1024.0).ToString("0.0")) KB</small>
                            <button class="ios-btn ios-btn-danger" style="padding: 3px 10px; font-size: 0.78rem;" @onclick="() => DeleteCompanyDocument(doc.Id)">@Loc["Delete"]</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Auth.IsAdmin)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
            <h3 class="ios-title mb-0" style="font-size: 1.4rem;">@Loc["Financials"]</h3>
        </div>
        <div class="ios-widget-card d-block w-100 mb-5">
            <div class="p-4 w-100">
                <SharedFinancials OwnerId="company.Id" OwnerType="company" />
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CompanyDto? company;

    // Incorporation Contract state
    private IBrowserFile? incorporationContractFile;
    private bool isUploadingIncorporationContract;

    private void LoadIncorporationFile(InputFileChangeEventArgs e)
    {
        incorporationContractFile = e.File;

    }

    private async Task UploadIncorporationContract()
    {
        if (company == null || incorporationContractFile == null) return;

        isUploadingIncorporationContract = true;

        try
        {
            var docId = await CompanyApi.UploadDocumentAsync("company", company.Id, incorporationContractFile);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            var updateDto = new UpdateCompanyDto(
                company.Category,
                company.CompanyName,
                company.CompanyNameEn,
                company.TradeName,
                company.EstablishmentDate,
                company.RegistrationNumber,
                company.Address,
                docId
            );
            await CompanyApi.UpdateAsync(company.Id, updateDto);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);

            incorporationContractFile = null;
            await LoadCompany();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to upload contract: " + ex.Message);
        }
        finally
        {
            isUploadingIncorporationContract = false;
        }
    }

    private async Task HandleContractReplace(IBrowserFile newFile)
    {
        incorporationContractFile = newFile;
        await UploadIncorporationContract();
    }

    private string NextAmendmentPlaceholder
    {
        get
        {
            if (company == null) return "عقد التعديل الأول";
            var nextSeq = company.Amendments.Count == 0 ? 1 : company.Amendments.Max(a => a.SequenceNumber) + 1;
            var ordinals = new[] { "الأول", "الثاني", "الثالث", "الرابع", "الخامس", "السادس", "السابع", "الثامن", "التاسع", "العاشر" };
            var ordinalStr = nextSeq <= 10 ? ordinals[nextSeq - 1] : nextSeq.ToString();
            return $"عقد التعديل {ordinalStr}";
        }
    }

    // Amendment state
    private bool showAddAmendmentForm;
    private string? newAmendmentTitle;
    private DateOnly? newAmendmentDate;
    private IBrowserFile? newAmendmentFile;
    private bool isSavingAmendment;

    // Partner state
    private bool showAddPartnerForm;
    private decimal? newPartnerOwnership;
    private bool isSavingPartner;

    // Client Search state for Partner selection
    private string? clientSearchTerm;
    private List<ClientSummaryDto>? clientSearchResults;
    private Guid? selectedClientId;
    private string? selectedClientName;

    // Company Documents state
    private List<LegalERP.Application.Companies.DocumentDto>? companyDocuments;
    private bool showAddCompanyDocForm;
    private string? newCompanyDocTitle;
    private IBrowserFile? newCompanyDocFile;
    private bool isUploadingCompanyDoc;

    private Guid _lastLoadedId;

    protected override void OnInitialized()
    {
        Auth.OnRoleChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _lastLoadedId)
        {
            _lastLoadedId = Id;
            await LoadCompany();
        }
    }

    public void Dispose()
    {
        Auth.OnRoleChanged -= StateHasChanged;
    }

    private async Task LoadCompany()
    {
        company = await CompanyApi.GetByIdAsync(Id);
        await LoadCompanyDocuments();
    }

    private async Task LoadCompanyDocuments()
    {
        try
        {
            companyDocuments = await CompanyApi.GetDocumentsAsync("companydoc", Id);
        }
        catch
        {
            companyDocuments = new List<LegalERP.Application.Companies.DocumentDto>();
        }
    }

    // ── Company Documents ──

    private void ToggleAddCompanyDocForm()
    {
        showAddCompanyDocForm = !showAddCompanyDocForm;

        newCompanyDocTitle = null;
        newCompanyDocFile = null;
    }

    private void LoadCompanyDocFile(InputFileChangeEventArgs e)
    {
        newCompanyDocFile = e.File;

    }

    private async Task UploadCompanyDocument()
    {
        if (newCompanyDocFile == null)
        {
            ToastService.ShowWarning(Loc["PleaseSelectFile"].Value);
            return;
        }

        isUploadingCompanyDoc = true;

        try
        {
            var docId = await CompanyApi.UploadDocumentAsync("companydoc", Id, newCompanyDocFile, newCompanyDocTitle);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            
            showAddCompanyDocForm = false;
            newCompanyDocTitle = null;
            newCompanyDocFile = null;
            
            await LoadCompanyDocuments();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Loc["FailedToUploadDoc"].Value + ": " + ex.Message);
        }
        finally
        {
            isUploadingCompanyDoc = false;
        }
    }

    private async Task DeleteCompanyDocument(Guid docId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteDoc"].Value);
        if (confirmed)
        {
            try
            {
                await CompanyApi.DeleteDocumentAsync(docId);
                ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
                await LoadCompanyDocuments();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", Loc["FailedToDeleteDoc"].Value + ": " + ex.Message);
            }
        }
    }

    private void GoBack() => NavManager.NavigateTo("/companies");
    // ── Amendments ──

    private void ToggleAddAmendmentForm()
    {
        showAddAmendmentForm = !showAddAmendmentForm;

        newAmendmentTitle = null;
        newAmendmentDate = null;
        newAmendmentFile = null;
    }

    private void LoadAmendmentFile(InputFileChangeEventArgs e)
    {
        newAmendmentFile = e.File;
    }

    private async Task AddAmendment()
    {

        isSavingAmendment = true;

        try
        {
            var dto = new CreateCompanyAmendmentDto(newAmendmentTitle, newAmendmentDate, null);
            var result = await CompanyApi.AddAmendmentAsync(Id, dto);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);

            if (result != null && newAmendmentFile != null)
            {
                var docId = await CompanyApi.UploadDocumentAsync("amendment", result.Id, newAmendmentFile);
                ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
                var updateDto = new UpdateCompanyAmendmentDto(result.Title, result.AmendmentDate, docId);
                await CompanyApi.UpdateAmendmentAsync(Id, result.Id, updateDto);
                ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            }

            showAddAmendmentForm = false;
            newAmendmentTitle = null;
            newAmendmentDate = null;
            newAmendmentFile = null;
            await LoadCompany();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Loc["FailedToAddAmendment"].Value + ": " + ex.Message);
        }
        finally
        {
            isSavingAmendment = false;
        }
    }

    private async Task DeleteAmendment(Guid amendmentId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteAmendment"].Value);
        if (confirmed)
        {
            await CompanyApi.DeleteAmendmentAsync(Id, amendmentId);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            await LoadCompany();
        }
    }

    // ── Partners ──

    private async Task HandleClientSearch(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(clientSearchTerm))
        {
            clientSearchResults = null;
            return;
        }

        clientSearchResults = await ClientApi.SearchAsync(clientSearchTerm);
    }

    private void SelectClient(ClientSummaryDto client)
    {
        selectedClientId = client.Id;
        selectedClientName = string.IsNullOrWhiteSpace(client.NationalIdNumber) 
            ? client.FullName 
            : $"{client.FullName} (ID: {client.NationalIdNumber})";
        clientSearchResults = null;
        clientSearchTerm = client.FullName;
    }

    private void ClearClientSelection()
    {
        selectedClientId = null;
        selectedClientName = null;
        clientSearchTerm = null;
        clientSearchResults = null;
    }

    private void ToggleAddPartnerForm()
    {
        showAddPartnerForm = !showAddPartnerForm;

        newPartnerOwnership = null;
        ClearClientSelection();
    }

    private async Task AddPartner()
    {

        if (!selectedClientId.HasValue)
        {
            ToastService.ShowWarning(Loc["MustSelectClient"].Value);
            return;
        }

        isSavingPartner = true;

        try
        {
            var dto = new CreateCompanyPartnerDto(selectedClientId.Value, newPartnerOwnership);
            await CompanyApi.AddPartnerAsync(Id, dto);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);

            showAddPartnerForm = false;
            newPartnerOwnership = null;
            ClearClientSelection();
            await LoadCompany();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Loc["FailedToAddPartner"].Value + ": " + ex.Message);
        }
        finally
        {
            isSavingPartner = false;
        }
    }

    private async Task DeletePartner(Guid partnerId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeletePartner"].Value);
        if (confirmed)
        {
            await CompanyApi.DeletePartnerAsync(Id, partnerId);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            await LoadCompany();
        }
    }

    private async Task HandleAmendmentReplace(Guid amendmentId, IBrowserFile newFile)
    {
        try
        {
            var amendment = company.Amendments.First(a => a.Id == amendmentId);
            var docId = await CompanyApi.UploadDocumentAsync("amendment", amendmentId, newFile);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            var updateDto = new UpdateCompanyAmendmentDto(amendment.Title, amendment.AmendmentDate, docId);
            await CompanyApi.UpdateAmendmentAsync(Id, amendmentId, updateDto);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            
            if (amendment.DocumentId.HasValue)
            {
                try { await CompanyApi.DeleteDocumentAsync(amendment.DocumentId.Value); } catch { /* ignore */ }
                ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            }

            await LoadCompany();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", Loc["FailedToUploadDoc"].Value + ": " + ex.Message);
        }
    }

    private async Task HandleCompanyDocumentReplace(Guid docId, IBrowserFile newFile)
    {
        try
        {
            await CompanyApi.UploadDocumentAsync("companydoc", Id, newFile);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            await CompanyApi.DeleteDocumentAsync(docId);
            ToastService.ShowSuccess(Loc["OperationSuccess"].Value);
            await LoadCompanyDocuments();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", Loc["FailedToUploadDoc"].Value + ": " + ex.Message);
        }
    }
}

