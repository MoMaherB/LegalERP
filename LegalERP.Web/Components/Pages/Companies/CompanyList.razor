@page "/companies"
@using LegalERP.Application.Companies
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CompanyApiClient CompanyApi
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.Toast.IToastService ToastService
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer

<PageTitle>@Loc["CompaniesManagement"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="ios-title mb-0">@Loc["CompaniesManagement"]</h1>
    <AuthorizeView Roles="SuperAdmin,Admin,Editor">
        <Authorized>
            <a href="/companies/new" class="ios-btn ios-btn-primary text-decoration-none">
                <i class="fa-solid fa-plus me-1"></i> @Loc["AddNewCompany"]
            </a>
        </Authorized>
    </AuthorizeView>
</div>

<!-- Search & Filter Controls -->
<div class="ios-widget-card mb-4 p-3 p-md-4">
    <div class="row g-3 align-items-end w-100 m-0">
        <div class="col-12 col-md-5 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["SearchNameTradeNameEnglish"]</label>
            <input type="text" class="ios-input" placeholder="@Loc["SearchCompaniesPlaceholder"]" 
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        </div>
        <div class="col-12 col-md-4 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["CategoryFilter"]</label>
            <select class="ios-select" @bind="selectedCategory">
                <option value="">@Loc["AllCategories"]</option>
                @foreach (var cat in Enum.GetValues<CompanyCategory>())
                {
                    <option value="@cat">@Loc[cat.ToString()]</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3 px-1 d-flex gap-2">
            <button class="ios-btn ios-btn-primary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
            <button class="ios-btn ios-btn-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
        </div>
    </div>
</div>

@if (companies is null)
{
    <p>@Loc["Loading"]</p>
}
else if (totalCount == 0)
{
    <div class="alert alert-info">
        @Loc["NoCompaniesMatch"]
    </div>
}
else
{
    <div class="ios-table-container">
        <table class="ios-table">
            <thead>
                <tr>
                    <th class="d-none d-md-table-cell">@Loc["FileNumber"]</th>
                    <th>@Loc["Name"]</th>
                    <th class="d-none d-md-table-cell">@Loc["TradeName"]</th>
                    <th>@Loc["Category"]</th>
                    <th class="text-center">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in companies)
                {
                    <tr>
                        <td class="d-none d-md-table-cell">
                            @if (!string.IsNullOrWhiteSpace(c.FileNumber))
                            {
                                <span class="ios-status-badge ios-status-gray">@c.FileNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <strong>@c.CompanyName</strong>
                            @if (!string.IsNullOrWhiteSpace(c.FileNumber))
                            {
                                <div class="d-md-none text-muted small mt-1">@Loc["FileNumber"]: @c.FileNumber</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.CompanyNameEn))
                            {
                                <br /><small class="text-muted">@c.CompanyNameEn</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.TradeName))
                            {
                                <div class="d-md-none text-muted small mt-1">@c.TradeName</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@(string.IsNullOrWhiteSpace(c.TradeName) ? "—" : c.TradeName)</td>
                        <td><span class="ios-status-badge ios-status-gray">@Loc[c.Category.ToString()]</span></td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                <a href="/companies/@c.Id" class="ios-btn ios-btn-info text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["View"]</a>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <a href="/companies/edit/@c.Id" class="ios-btn ios-btn-secondary text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["Edit"]</a>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <button class="ios-btn ios-btn-danger m-0" style="padding: 4px 8px; font-size: 0.8rem;" @onclick="() => DeleteCompany(c.Id)">@Loc["Delete"]</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (totalCount > 0)
    {
        var startItem = (currentPage - 1) * pageSize + 1;
        var endItem = Math.Min(currentPage * pageSize, totalCount);

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3 px-1 py-2">
            <div class="ios-details text-muted">
                @Loc["Showing"] <strong>@startItem</strong> @Loc["To"] <strong>@endItem</strong> @Loc["Of"] <strong>@totalCount</strong> @Loc["Companies"]
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="d-flex align-items-center gap-1 me-2">
                    <label class="ios-details text-muted mb-0 me-1">@Loc["RowsPerPage"]:</label>
                    <select class="ios-select form-select-sm py-1 px-2" style="width: auto;" value="@pageSize" @onchange="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <div class="btn-group" role="group" aria-label="Pagination">
                    <button class="ios-btn ios-btn-secondary py-1 px-3 pagination-prev"
                            disabled="@(!hasPreviousPage)"
                            @onclick="() => GoToPage(currentPage - 1)">
                        <i class="fa-solid fa-chevron-left me-1 rtl-flip"></i> @Loc["Previous"]
                    </button>

                    <span class="d-flex align-items-center px-3 ios-badge ios-details fw-semibold text-body pagination-indicator">
                        @Loc["Page"] @currentPage / @Math.Max(1, totalPages)
                    </span>

                    <button class="ios-btn ios-btn-secondary py-1 px-3 pagination-next"
                            disabled="@(!hasNextPage)"
                            @onclick="() => GoToPage(currentPage + 1)">
                        @Loc["Next"] <i class="fa-solid fa-chevron-right ms-1 rtl-flip"></i>
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<CompanyDto>? companies;
    private string? searchTerm;
    private CompanyCategory? selectedCategory;

    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int totalPages = 1;
    private bool hasPreviousPage => currentPage > 1;
    private bool hasNextPage => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch(1);
    }

    private Task PerformSearch() => PerformSearch(1);

    private async Task PerformSearch(int page)
    {
        currentPage = Math.Max(1, page);
        var paged = string.IsNullOrWhiteSpace(searchTerm) && !selectedCategory.HasValue
            ? await CompanyApi.GetPagedAsync(currentPage, pageSize)
            : await CompanyApi.SearchPagedAsync(searchTerm, selectedCategory, currentPage, pageSize);

        companies = paged.Items;
        totalCount = paged.TotalCount;
        currentPage = paged.PageNumber;
        pageSize = paged.PageSize;
        totalPages = paged.TotalPages;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            await PerformSearch(1);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages) || page == currentPage)
            return;
        await PerformSearch(page);
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        selectedCategory = null;
        currentPage = 1;
        await PerformSearch(1);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch(1);
        }
    }

    private async Task DeleteCompany(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteCompany"].Value);
        if (confirmed)
        {
            await CompanyApi.DeleteAsync(id);
            ToastService.ShowSuccess(Loc["CompanyDeleted"].Value);
            var targetPage = (companies?.Count == 1 && currentPage > 1) ? currentPage - 1 : currentPage;
            await PerformSearch(targetPage);
        }
    }
}



