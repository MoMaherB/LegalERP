@page "/companies"
@using LegalERP.Application.Companies
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CompanyApiClient CompanyApi
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer

<PageTitle>@Loc["CompaniesManagement"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Loc["CompaniesManagement"]</h1>
    <a href="/companies/new" class="btn btn-primary">@Loc["AddNewCompany"]</a>
</div>

<!-- Search & Filter Controls -->
<div class="glass-card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label font-weight-bold">@Loc["SearchNameTradeNameEnglish"]</label>
                <input type="text" class="form-control" placeholder="@Loc["SearchCompaniesPlaceholder"]" 
                       @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-bold">@Loc["CategoryFilter"]</label>
                <select class="form-select" @bind="selectedCategory">
                    <option value="">@Loc["AllCategories"]</option>
                    @foreach (var cat in Enum.GetValues<CompanyCategory>())
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-secondary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
                <button class="btn btn-outline-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
            </div>
        </div>
    </div>
</div>

@if (companies is null)
{
    <p>@Loc["Loading"]</p>
}
else if (companies.Count == 0)
{
    <div class="alert alert-info">
        @Loc["NoCompaniesMatch"]
    </div>
}
else
{
    <table class="table table-hover align-middle table-glass">
        <thead>
            <tr>
                <th>@Loc["Name"]</th>
                <th>@Loc["TradeName"]</th>
                <th>@Loc["Category"]</th>
                <th>@Loc["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in companies)
            {
                <tr>
                    <td>
                        <strong>@c.CompanyName</strong>
                        @if (!string.IsNullOrWhiteSpace(c.CompanyNameEn))
                        {
                            <br /><small class="text-muted">@c.CompanyNameEn</small>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(c.TradeName) ? "—" : c.TradeName)</td>
                    <td><span class="badge bg-secondary">@c.Category</span></td>
                    <td>
                        <a href="/companies/@c.Id" class="btn btn-sm btn-info me-2">@Loc["View"]</a>
                        <a href="/companies/edit/@c.Id" class="btn btn-sm btn-secondary me-2">@Loc["Edit"]</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCompany(c.Id)">@Loc["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CompanyDto>? companies;
    private string? searchTerm;
    private CompanyCategory? selectedCategory;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        companies = await CompanyApi.SearchAsync(searchTerm, selectedCategory);
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        selectedCategory = null;
        await PerformSearch();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task DeleteCompany(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this company? This action cannot be undone.");
        if (confirmed)
        {
            await CompanyApi.DeleteAsync(id);
            await PerformSearch();
        }
    }
}
