@page "/companies"
@using LegalERP.Application.Companies
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@inject CompanyApiClient CompanyApi
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.Toast.IToastService ToastService
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@rendermode InteractiveServer

<PageTitle>@Loc["CompaniesManagement"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="ios-title mb-0">@Loc["CompaniesManagement"]</h1>
    <AuthorizeView Roles="SuperAdmin,Admin,Editor">
        <Authorized>
            <a href="/companies/new" class="ios-btn ios-btn-primary text-decoration-none">
                <i class="fa-solid fa-plus me-1"></i> @Loc["AddNewCompany"]
            </a>
        </Authorized>
    </AuthorizeView>
</div>

<!-- Search & Filter Controls -->
<div class="ios-widget-card mb-4 p-3 p-md-4">
    <div class="row g-3 align-items-end w-100 m-0">
        <div class="col-12 col-md-5 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["SearchNameTradeNameEnglish"]</label>
            <input type="text" class="ios-input" placeholder="@Loc["SearchCompaniesPlaceholder"]" 
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        </div>
        <div class="col-12 col-md-4 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["CategoryFilter"]</label>
            <select class="ios-select" @bind="selectedCategory">
                <option value="">@Loc["AllCategories"]</option>
                @foreach (var cat in Enum.GetValues<CompanyCategory>())
                {
                    <option value="@cat">@Loc[cat.ToString()]</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3 px-1 d-flex gap-2">
            <button class="ios-btn ios-btn-primary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
            <button class="ios-btn ios-btn-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
        </div>
    </div>
</div>

@if (companies is null)
{
    <p>@Loc["Loading"]</p>
}
else if (companies.Count == 0)
{
    <div class="alert alert-info">
        @Loc["NoCompaniesMatch"]
    </div>
}
else
{
    <div class="ios-table-container">
        <table class="ios-table">
            <thead>
                <tr>
                    <th>@Loc["Name"]</th>
                    <th class="d-none d-md-table-cell">@Loc["TradeName"]</th>
                    <th>@Loc["Category"]</th>
                    <th class="text-center">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in companies)
                {
                    <tr>
                        <td>
                            <strong>@c.CompanyName</strong>
                            @if (!string.IsNullOrWhiteSpace(c.CompanyNameEn))
                            {
                                <br /><small class="text-muted">@c.CompanyNameEn</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.TradeName))
                            {
                                <div class="d-md-none text-muted small mt-1">@c.TradeName</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@(string.IsNullOrWhiteSpace(c.TradeName) ? "—" : c.TradeName)</td>
                        <td><span class="ios-status-badge ios-status-gray">@Loc[c.Category.ToString()]</span></td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                <a href="/companies/@c.Id" class="ios-btn ios-btn-info text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["View"]</a>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <a href="/companies/edit/@c.Id" class="ios-btn ios-btn-secondary text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["Edit"]</a>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <button class="ios-btn ios-btn-danger m-0" style="padding: 4px 8px; font-size: 0.8rem;" @onclick="() => DeleteCompany(c.Id)">@Loc["Delete"]</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CompanyDto>? companies;
    private string? searchTerm;
    private CompanyCategory? selectedCategory;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        companies = await CompanyApi.SearchAsync(searchTerm, selectedCategory);
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        selectedCategory = null;
        await PerformSearch();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task DeleteCompany(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteCompany"].Value);
        if (confirmed)
        {
            await CompanyApi.DeleteAsync(id);
            ToastService.ShowSuccess(Loc["CompanyDeleted"].Value);
            await PerformSearch();
        }
    }
}



