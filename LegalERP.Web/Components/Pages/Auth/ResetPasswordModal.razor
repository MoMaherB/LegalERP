@inject LegalERP.Web.Services.UserApiClient UserApi
@inject IStringLocalizer<SharedResources> Loc
@inject LegalERP.Web.Services.Toast.IToastService Toast

@if (_isVisible)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(6px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="background: rgba(30,35,50,0.92); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px;">
                <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                    <h5 class="modal-title fw-bold text-warning">
                        <i class="fa-solid fa-key me-2"></i>@Loc["ResetPassword"]
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                
                <div class="modal-body pt-4">
                    <p class="text-muted mb-4 small">@Loc["ResetPasswordWarning"] <strong class="text-white">@_userName</strong>.</p>
                    
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert py-2 mb-3 d-flex align-items-center gap-2 small"
                             style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; border-radius: 10px;">
                            <i class="fa-solid fa-circle-exclamation"></i> @_errorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">@Loc["NewPassword"]</label>
                        <input type="text" class="form-control ios-input" @bind="_newPassword" @bind:event="oninput" 
                               placeholder="كلمة المرور الجديدة (8 أحرف على الأقل)" />
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary border-opacity-25 pt-3 gap-2 d-flex justify-content-end">
                    <button type="button" class="btn ios-btn-secondary px-4" @onclick="Close" disabled="@_isSaving">
                        @Loc["Cancel"]
                    </button>
                    <button type="button" class="btn ios-btn-warning px-4" @onclick="Save" disabled="@_isSaving">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        <i class="fa-solid fa-unlock-keyhole me-1"></i> @Loc["Reset"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private bool _isSaving;
    private Guid _userId;
    private string _userName = "";
    private string _newPassword = "";
    private string _errorMessage = "";

    public void Show(LegalERP.Application.Auth.UserDto user)
    {
        _userId = user.Id;
        _userName = user.FullName;
        _newPassword = "";
        _errorMessage = "";
        _isVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task Save()
    {
        _errorMessage = "";

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMessage = "يرجى إدخال كلمة المرور الجديدة.";
            return;
        }
        
        if (_newPassword.Length < 8)
        {
            _errorMessage = "يجب أن تكون كلمة المرور 8 أحرف على الأقل.";
            return;
        }

        _isSaving = true;

        try
        {
            var (success, msg) = await UserApi.ResetPasswordAsync(_userId, _newPassword);
            
            if (success)
            {
                Toast.ShowSuccess(Loc["OperationSuccess"].Value);
                Close();
            }
            else
            {
                _errorMessage = msg;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "حدث خطأ أثناء الحفظ. تأكد من اتصال الـ API.";
            Console.WriteLine($"[RESET PASSWORD ERROR] {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }
}
