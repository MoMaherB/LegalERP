@page "/"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>LegalERP | @Loc["Home"]</PageTitle>

<div class="glass-card mb-4">
    <h1>@Loc["Home"]</h1>
    <p>Welcome to LegalERP.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="glass-card">
            <h5 class="glass-card-header">@Loc["Companies"]</h5>
            <p>Manage company records, partners, and amendments.</p>
            <a href="/companies" class="btn btn-primary glass-panel">@Loc["Companies"]</a>
        </div>
    </div>
</div>