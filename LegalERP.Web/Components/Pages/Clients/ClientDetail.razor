@page "/clients/{Id:guid}"
@using LegalERP.Application.Clients
@using LegalERP.Application.Companies
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@using LegalERP.Web.Components.Shared
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["ClientDetails"] - @(client?.FullName ?? Loc["Loading"])</PageTitle>

@if (client is null)
{
    @if (notFound)
    {
        <div class="alert alert-warning">
            @Loc["ClientNotFound"] <a href="/clients">@Loc["BackToClients"]</a>
        </div>
    }
    else
    {
        <p>@Loc["LoadingClientDetails"]</p>
    }
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/clients" class="ios-btn ios-btn-secondary me-2 text-decoration-none">@Loc["BackToList"]</a>
            <a href="/clients/edit/@client.Id" class="ios-btn ios-btn-primary me-2 text-decoration-none">@Loc["EditClient"]</a>
        </div>
        <button class="ios-btn ios-btn-danger" @onclick="DeleteClient">@Loc["DeleteClient"]</button>
    </div>

    @* ── Personal Information Card ── *@
    <div class="ios-widget-card mb-4">
        <div class="p-4">
            <h3 class="ios-title mb-0">@client.FullName</h3>
            @if (!string.IsNullOrWhiteSpace(client.FullNameEn))
            {
                <small class="text-muted">@client.FullNameEn</small>
            }
            <div class="row g-3 mt-3">
                <div class="col-md-4">
                    <strong class="ios-details fw-bold">@Loc["NationalId"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.NationalIdNumber) ? "—" : client.NationalIdNumber)</p>
                </div>
                <div class="col-md-4">
                    <strong class="ios-details fw-bold">@Loc["Phone"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.PhoneNumber) ? "—" : client.PhoneNumber)</p>
                </div>
                <div class="col-md-4">
                    <strong class="ios-details fw-bold">@Loc["Email"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.Email) ? "—" : client.Email)</p>
                </div>
                <div class="col-12">
                    <strong class="ios-details fw-bold">@Loc["Address"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.Address) ? "—" : client.Address)</p>
                </div>
                <div class="col-12">
                    <strong class="ios-details fw-bold">@Loc["Notes"]:</strong>
                    <p class="border p-3 rounded mb-0 mt-2" style="background: rgba(0,0,0,0.02); border-color: rgba(0,0,0,0.05) !important;">
                        @(string.IsNullOrWhiteSpace(client.Notes) ? Loc["NoNotesRecorded"] : client.Notes)
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ── Documents Card ── *@
    <div class="ios-widget-card mb-4">
        <div class="p-4">
            <h4 class="ios-title mb-4" style="font-size: 1.3rem;">@Loc["Documents"]</h4>
            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="ios-title" style="font-size: 1.1rem;">@Loc["NationalIdScan"]</h5>
                    @if (client.NationalIdDocument != null)
                    {
                        <div class="my-3 p-3 rounded w-100" style="background: rgba(0,0,0,0.02);">
                            <FileThumbnail Document="client.NationalIdDocument" OwnerType="client" OwnerId="client.Id" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mt-3" style="border-radius: 12px;">@Loc["NoNationalIdUploaded"] <a href="/clients/edit/@client.Id">@Loc["UploadNow"]</a>.</div>
                    }
                </div>
                <div class="col-md-6">
                    <h5 class="ios-title" style="font-size: 1.1rem;">@Loc["PowerOfAttorney"]</h5>
                    @if (client.AttorneyDocument != null)
                    {
                        <div class="my-3 p-3 rounded w-100" style="background: rgba(0,0,0,0.02);">
                            <FileThumbnail Document="client.AttorneyDocument" OwnerType="client" OwnerId="client.Id" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mt-3" style="border-radius: 12px;">@Loc["NoAttorneyDocumentUploaded"] <a href="/clients/edit/@client.Id">@Loc["UploadNow"]</a>.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Related Cases ── *@
    <div class="ios-widget-card mb-4">
        <div class="p-4">
            <h4 class="ios-title mb-4" style="font-size: 1.3rem;">@Loc["RelatedCases"]</h4>
            @if (client.RelatedCases.Count == 0)
            {
                <div class="alert alert-light border mb-0" style="border-radius: 12px;">@Loc["ClientNoRelatedCases"]</div>
            }
            else
            {
                <div class="ios-table-container">
                    <table class="ios-table mb-0">
                        <thead>
                            <tr>
                                <th>@Loc["CaseNumber"]</th>
                                <th>@Loc["Title"]</th>
                                <th>@Loc["Type"]</th>
                                <th>@Loc["Role"]</th>
                                <th>@Loc["Representation"]</th>
                                <th>@Loc["Status"]</th>
                                <th>@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in client.RelatedCases)
                            {
                                <tr>
                                    <td><strong>@c.CaseNumber</strong></td>
                                    <td>@c.CaseTitle</td>
                                    <td><span class="ios-status-badge ios-status-gray">@c.CaseType</span></td>
                                    <td>
                                        <span class="ios-status-badge ios-status-gray">
                                            @(c.PartyRole == PartyRole.Defendant ? Loc["Defendant"] : Loc["Victim"])
                                        </span>
                                    </td>
                                    <td>
                                        @if (c.IsOurClient)
                                        {
                                            <span class="ios-status-badge ios-status-green">@Loc["Client"]</span>
                                        }
                                        else
                                        {
                                            <span class="ios-status-badge ios-status-red">@Loc["Opponent"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.CaseStatus == CaseStatus.Active)
                                        {
                                            <span class="ios-status-badge ios-status-amber">@Loc["Active"]</span>
                                        }
                                        else
                                        {
                                            @if (c.CaseOutcome == CaseOutcome.Won)
                                            {
                                                <span class="ios-status-badge ios-status-green">@Loc["ClosedWon"]</span>
                                            }
                                            else if (c.CaseOutcome == CaseOutcome.Lost)
                                            {
                                                <span class="ios-status-badge ios-status-red">@Loc["ClosedLost"]</span>
                                            }
                                            else if (c.CaseOutcome == CaseOutcome.Settled)
                                            {
                                                <span class="ios-status-badge ios-status-blue">@Loc["ClosedSettled"]</span>
                                            }
                                            else
                                            {
                                                <span class="ios-status-badge ios-status-green">@Loc["Closed"]</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <a href="/cases/@c.CaseId" class="ios-btn ios-btn-info text-decoration-none" style="padding: 4px 10px; font-size: 0.85rem;">@Loc["ViewCase"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Related Companies ── *@
    <div class="ios-widget-card mb-4">
        <div class="p-4">
            <h4 class="ios-title mb-4" style="font-size: 1.3rem;">@Loc["RelatedCompanies"]</h4>
            @if (client.RelatedCompanies.Count == 0)
            {
                <div class="alert alert-light border mb-0" style="border-radius: 12px;">@Loc["ClientNoRelatedCompanies"]</div>
            }
            else
            {
                <div class="ios-table-container">
                    <table class="ios-table mb-0">
                        <thead>
                            <tr>
                                <th>@Loc["CompanyName"]</th>
                                <th>@Loc["OwnershipPercentage"]</th>
                                <th>@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var co in client.RelatedCompanies)
                            {
                                <tr>
                                    <td><strong>@co.CompanyName</strong></td>
                                    <td>@(co.OwnershipPercentage.HasValue ? $"{co.OwnershipPercentage.Value:F2}%" : "—")</td>
                                    <td>
                                        <a href="/companies/@co.CompanyId" class="ios-btn ios-btn-info text-decoration-none" style="padding: 4px 10px; font-size: 0.85rem;">@Loc["ViewCompany"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ClientDto? client;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        client = await ClientApi.GetByIdAsync(Id);
        if (client is null)
        {
            notFound = true;
        }
    }

    private async Task DeleteClient()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteClient"]);
        if (confirmed)
        {
            await ClientApi.DeleteAsync(Id);
            NavManager.NavigateTo("/clients");
        }
    }
}
