@page "/clients/{Id:guid}"
@using LegalERP.Application.Clients
@using LegalERP.Application.Companies
@using LegalERP.Domain.Enums
@using LegalERP.Web.Services
@using LegalERP.Web.Components.Shared
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["ClientDetails"] - @(client?.FullName ?? Loc["Loading"])</PageTitle>

@if (client is null)
{
    @if (notFound)
    {
        <div class="alert alert-warning">
            @Loc["ClientNotFound"] <a href="/clients">@Loc["BackToClients"]</a>
        </div>
    }
    else
    {
        <p>@Loc["LoadingClientDetails"]</p>
    }
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/clients" class="btn btn-outline-secondary me-2">@Loc["BackToList"]</a>
            <a href="/clients/edit/@client.Id" class="btn btn-primary me-2">@Loc["EditClient"]</a>
        </div>
        <button class="btn btn-danger" @onclick="DeleteClient">@Loc["DeleteClient"]</button>
    </div>

    @* ── Personal Information Card ── *@
    <div class="glass-card mb-4">
        <div class="glass-card-header">
            <h3 class="mb-0">@client.FullName</h3>
            @if (!string.IsNullOrWhiteSpace(client.FullNameEn))
            {
                <small class="text-muted">@client.FullNameEn</small>
            }
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>@Loc["NationalId"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.NationalIdNumber) ? "—" : client.NationalIdNumber)</p>
                </div>
                <div class="col-md-4">
                    <strong>@Loc["Phone"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.PhoneNumber) ? "—" : client.PhoneNumber)</p>
                </div>
                <div class="col-md-4">
                    <strong>@Loc["Email"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.Email) ? "—" : client.Email)</p>
                </div>
                <div class="col-12">
                    <strong>@Loc["Address"]:</strong>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(client.Address) ? "—" : client.Address)</p>
                </div>
                <div class="col-12">
                    <strong>@Loc["Notes"]:</strong>
                    <p class="border p-3 rounded bg-light mb-0">
                        @(string.IsNullOrWhiteSpace(client.Notes) ? Loc["NoNotesRecorded"] : client.Notes)
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ── Documents Card ── *@
    <div class="glass-card mb-4">
        <div class="glass-card-header">
            <h4 class="mb-0">@Loc["Documents"]</h4>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <h5>@Loc["NationalIdScan"]</h5>
                    @if (client.NationalIdDocument != null)
                    {
                        <FileThumbnail Document="client.NationalIdDocument" OwnerType="client" OwnerId="client.Id" />
                    }
                    else
                    {
                        <div class="alert alert-light border">@Loc["NoNationalIdUploaded"] <a href="/clients/edit/@client.Id">@Loc["UploadNow"]</a>.</div>
                    }
                </div>
                <div class="col-md-6">
                    <h5>@Loc["PowerOfAttorney"]</h5>
                    @if (client.AttorneyDocument != null)
                    {
                        <FileThumbnail Document="client.AttorneyDocument" OwnerType="client" OwnerId="client.Id" />
                    }
                    else
                    {
                        <div class="alert alert-light border">@Loc["NoAttorneyDocumentUploaded"] <a href="/clients/edit/@client.Id">@Loc["UploadNow"]</a>.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Related Cases ── *@
    <div class="glass-card mb-4">
        <div class="glass-card-header">
            <h4 class="mb-0">@Loc["RelatedCases"]</h4>
        </div>
        <div class="card-body">
            @if (client.RelatedCases.Count == 0)
            {
                <div class="alert alert-light border mb-0">@Loc["ClientNoRelatedCases"]</div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0 table-glass">
                    <thead>
                        <tr>
                            <th>@Loc["CaseNumber"]</th>
                            <th>@Loc["Title"]</th>
                            <th>@Loc["Type"]</th>
                            <th>@Loc["Role"]</th>
                            <th>@Loc["Representation"]</th>
                            <th>@Loc["Status"]</th>
                            <th>@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in client.RelatedCases)
                        {
                            <tr>
                                <td><strong>@c.CaseNumber</strong></td>
                                <td>@c.CaseTitle</td>
                                <td><span class="badge bg-secondary">@c.CaseType</span></td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @(c.PartyRole == PartyRole.Defendant ? Loc["Defendant"] : Loc["Victim"])
                                    </span>
                                </td>
                                <td>
                                    @if (c.IsOurClient)
                                    {
                                        <span class="badge bg-success px-3 py-2">@Loc["Client"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2">@Loc["Opponent"]</span>
                                    }
                                </td>
                                <td>
                                    @if (c.CaseStatus == CaseStatus.Active)
                                    {
                                        <span class="badge bg-warning text-dark">@Loc["Active"]</span>
                                    }
                                    else
                                    {
                                        @if (c.CaseOutcome == CaseOutcome.Won)
                                        {
                                            <span class="badge bg-success">@Loc["ClosedWon"]</span>
                                        }
                                        else if (c.CaseOutcome == CaseOutcome.Lost)
                                        {
                                            <span class="badge bg-danger">@Loc["ClosedLost"]</span>
                                        }
                                        else if (c.CaseOutcome == CaseOutcome.Settled)
                                        {
                                            <span class="badge bg-info text-dark">@Loc["ClosedSettled"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@Loc["Closed"]</span>
                                        }
                                    }
                                </td>
                                <td>
                                    <a href="/cases/@c.CaseId" class="btn btn-sm btn-info">@Loc["ViewCase"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* ── Related Companies ── *@
    <div class="glass-card mb-4">
        <div class="glass-card-header">
            <h4 class="mb-0">@Loc["RelatedCompanies"]</h4>
        </div>
        <div class="card-body">
            @if (client.RelatedCompanies.Count == 0)
            {
                <div class="alert alert-light border mb-0">@Loc["ClientNoRelatedCompanies"]</div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0 table-glass">
                    <thead>
                        <tr>
                            <th>@Loc["CompanyName"]</th>
                            <th>@Loc["OwnershipPercentage"]</th>
                            <th>@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var co in client.RelatedCompanies)
                        {
                            <tr>
                                <td><strong>@co.CompanyName</strong></td>
                                <td>@(co.OwnershipPercentage.HasValue ? $"{co.OwnershipPercentage.Value:F2}%" : "—")</td>
                                <td>
                                    <a href="/companies/@co.CompanyId" class="btn btn-sm btn-info">@Loc["ViewCompany"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ClientDto? client;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        client = await ClientApi.GetByIdAsync(Id);
        if (client is null)
        {
            notFound = true;
        }
    }

    private async Task DeleteClient()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteClient"]);
        if (confirmed)
        {
            await ClientApi.DeleteAsync(Id);
            NavManager.NavigateTo("/clients");
        }
    }
}
