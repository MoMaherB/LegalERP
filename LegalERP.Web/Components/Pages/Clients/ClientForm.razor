@page "/clients/new"
@page "/clients/edit/{Id:guid}"
@using LegalERP.Application.Clients
@using LegalERP.Application.Companies
@using LegalERP.Web.Services
@inject ClientApiClient ClientApi
@inject CompanyApiClient CompanyApi
@inject NavigationManager NavManager
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@(IsEditMode ? Loc["EditClient"] : Loc["AddNewClient"])</PageTitle>

<h1 class="mb-4">@(IsEditMode ? Loc["EditClient"] : Loc["AddNewClient"])</h1>

@if (isLoading)
{
    <p>@Loc["Loading"]</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="glass-card mb-4">
            <div class="glass-card-header">
                <h5 class="mb-0">@Loc["PersonalInformation"]</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Loc["FullNameArabic"] *</label>
                        <InputText class="form-control" @bind-Value="model.FullName" placeholder="@Loc["FullNameArabicPlaceholder"]" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Loc["FullNameEnglish"]</label>
                        <InputText class="form-control" @bind-Value="model.FullNameEn" placeholder="@Loc["FullNameEnglishPlaceholder"]" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">@Loc["NationalIdNumber"] *</label>
                        <InputText class="form-control" @bind-Value="model.NationalIdNumber" placeholder="@Loc["NationalIdNumberPlaceholder"]" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Loc["PhoneNumber"]</label>
                        <InputText class="form-control" @bind-Value="model.PhoneNumber" placeholder="@Loc["PhoneNumberPlaceholder"]" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Loc["Email"]</label>
                        <InputText class="form-control" @bind-Value="model.Email" placeholder="@Loc["EmailPlaceholder"]" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">@Loc["Address"]</label>
                        <InputText class="form-control" @bind-Value="model.Address" placeholder="@Loc["AddressPlaceholder"]" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">@Loc["Notes"]</label>
                        <InputTextArea class="form-control" @bind-Value="model.Notes" rows="3" placeholder="@Loc["NotesPlaceholder"]" />
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card mb-4">
            <div class="glass-card-header">
                <h5 class="mb-0">@Loc["Documents"]</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Loc["NationalIdScan"]</label>
                        <InputFile class="form-control" OnChange="LoadNationalIdFile" accept=".pdf,.jpg,.jpeg,.png" />
                        @if (existingNationalIdDoc != null)
                        {
                            <small class="text-success mt-1 d-block">@Loc["Current"]: @existingNationalIdDoc.FileName</small>
                        }
                        @if (nationalIdFile != null)
                        {
                            <small class="text-primary mt-1 d-block">@Loc["NewFile"]: @nationalIdFile.Name</small>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Loc["PowerOfAttorney"]</label>
                        <InputFile class="form-control" OnChange="LoadAttorneyFile" accept=".pdf,.jpg,.jpeg,.png" />
                        @if (existingAttorneyDoc != null)
                        {
                            <small class="text-success mt-1 d-block">@Loc["Current"]: @existingAttorneyDoc.FileName</small>
                        }
                        @if (attorneyFile != null)
                        {
                            <small class="text-primary mt-1 d-block">@Loc["NewFile"]: @attorneyFile.Name</small>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-3">@errorMessage</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                @(isSubmitting ? Loc["Saving"] : (IsEditMode ? Loc["SaveChanges"] : Loc["CreateClient"]))
            </button>
            <a href="/clients" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;
    private ClientFormModel model = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;

    private IBrowserFile? nationalIdFile;
    private IBrowserFile? attorneyFile;
    private DocumentDto? existingNationalIdDoc;
    private DocumentDto? existingAttorneyDoc;

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            var existing = await ClientApi.GetByIdAsync(Id!.Value);
            if (existing != null)
            {
                model = new ClientFormModel
                {
                    FullName = existing.FullName,
                    FullNameEn = existing.FullNameEn,
                    NationalIdNumber = existing.NationalIdNumber,
                    PhoneNumber = existing.PhoneNumber,
                    Email = existing.Email,
                    Address = existing.Address,
                    Notes = existing.Notes,
                    NationalIdDocumentId = existing.NationalIdDocument?.Id,
                    AttorneyDocumentId = existing.AttorneyDocument?.Id
                };
                existingNationalIdDoc = existing.NationalIdDocument;
                existingAttorneyDoc = existing.AttorneyDocument;
            }
            else
            {
                errorMessage = "Client not found.";
            }
        }
        isLoading = false;
    }

    private void LoadNationalIdFile(InputFileChangeEventArgs e)
    {
        nationalIdFile = e.File;
    }

    private void LoadAttorneyFile(InputFileChangeEventArgs e)
    {
        attorneyFile = e.File;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(model.FullName))
        {
            errorMessage = "Full Name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.NationalIdNumber))
        {
            errorMessage = "National ID Number (رقم الهوية) is required.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            // Upload new documents if provided
            Guid? natIdDocId = model.NationalIdDocumentId;
            Guid? attDocId = model.AttorneyDocumentId;

            if (nationalIdFile != null)
            {
                natIdDocId = await CompanyApi.UploadDocumentAsync("client", IsEditMode ? Id!.Value : Guid.NewGuid(), nationalIdFile);
            }

            if (attorneyFile != null)
            {
                attDocId = await CompanyApi.UploadDocumentAsync("client", IsEditMode ? Id!.Value : Guid.NewGuid(), attorneyFile);
            }

            if (IsEditMode)
            {
                var updateDto = new UpdateClientDto(
                    model.FullName,
                    model.FullNameEn,
                    model.NationalIdNumber,
                    model.PhoneNumber,
                    model.Email,
                    model.Address,
                    model.Notes,
                    natIdDocId,
                    attDocId
                );
                await ClientApi.UpdateAsync(Id!.Value, updateDto);
                NavManager.NavigateTo($"/clients/{Id.Value}");
            }
            else
            {
                var createDto = new CreateClientDto(
                    model.FullName,
                    model.FullNameEn,
                    model.NationalIdNumber,
                    model.PhoneNumber,
                    model.Email,
                    model.Address,
                    model.Notes,
                    natIdDocId,
                    attDocId
                );
                var created = await ClientApi.CreateAsync(createDto);
                if (created != null)
                {
                    NavManager.NavigateTo($"/clients/{created.Id}");
                }
                else
                {
                    NavManager.NavigateTo("/clients");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to save client: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class ClientFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string? FullNameEn { get; set; }
        public string? NationalIdNumber { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? Notes { get; set; }
        public Guid? NationalIdDocumentId { get; set; }
        public Guid? AttorneyDocumentId { get; set; }
    }
}
