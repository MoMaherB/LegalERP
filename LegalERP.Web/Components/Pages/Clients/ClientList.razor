@page "/clients"
@using LegalERP.Application.Clients
@using LegalERP.Web.Services
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.Toast.IToastService ToastService
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["ClientsManagement"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="ios-title mb-0">@Loc["Clients"]</h1>
    <AuthorizeView Roles="SuperAdmin,Admin,Editor">
        <Authorized>
            <a href="/clients/new" class="ios-btn ios-btn-primary text-decoration-none">
                <i class="fa-solid fa-plus me-1"></i> @Loc["AddClient"]
            </a>
        </Authorized>
    </AuthorizeView>
</div>

<!-- Search Controls -->
<div class="ios-widget-card mb-4 p-3 p-md-4">
    <div class="row g-3 align-items-end w-100 m-0">
        <div class="col-12 col-md-8 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["SearchByName"]</label>
            <input type="text" class="ios-input" placeholder="@Loc["SearchClientsPlaceholder"]" 
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        </div>
        <div class="col-12 col-md-4 px-1 d-flex gap-2">
            <button class="ios-btn ios-btn-primary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
            <button class="ios-btn ios-btn-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
        </div>
    </div>
</div>

@if (clients is null)
{
    <p>@Loc["Loading"]</p>
}
else if (clients.Count == 0)
{
    <div class="alert alert-info">
        @Loc["NoClientsFound"] 
        <AuthorizeView Roles="SuperAdmin,Admin,Editor">
            <Authorized>
                <a href="/clients/new">@Loc["AddFirstClient"]</a>.
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="ios-table-container">
        <table class="ios-table">
            <thead>
                <tr>
                    <th class="d-none d-md-table-cell">@Loc["FileNumber"]</th>
                    <th>@Loc["FullName"]</th>
                    <th class="d-none d-md-table-cell">@Loc["NationalID"]</th>
                    <th>@Loc["Phone"]</th>
                    <th class="text-center">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clients)
                {
                    <tr>
                        <td class="d-none d-md-table-cell">
                            @if (!string.IsNullOrWhiteSpace(c.FileNumber))
                            {
                                <span class="ios-status-badge ios-status-gray">@c.FileNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <strong>@c.FullName</strong>
                            @if (!string.IsNullOrWhiteSpace(c.FileNumber))
                            {
                                <div class="d-md-none text-muted small mt-1">@Loc["FileNumber"]: @c.FileNumber</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.NationalIdNumber))
                            {
                                <div class="d-md-none text-muted small mt-1">@c.NationalIdNumber</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@(c.NationalIdNumber ?? "—")</td>
                        <td>@(c.PhoneNumber ?? "—")</td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                <a href="/clients/@c.Id" class="ios-btn ios-btn-info text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["View"]</a>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <a href="/clients/edit/@c.Id" class="ios-btn ios-btn-secondary text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["Edit"]</a>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <button class="ios-btn ios-btn-danger m-0" style="padding: 4px 8px; font-size: 0.8rem;" @onclick="() => DeleteClient(c.Id)">@Loc["Delete"]</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ClientSummaryDto>? clients;
    private string? searchTerm;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            clients = await ClientApi.GetAllAsync();
        }
        else
        {
            clients = await ClientApi.SearchAsync(searchTerm);
        }
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        await PerformSearch();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task DeleteClient(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteClient"]);
        if (confirmed)
        {
            await ClientApi.DeleteAsync(id);
            ToastService.ShowSuccess(Loc["ClientDeleted"].Value);
            await PerformSearch();
        }
    }
}



