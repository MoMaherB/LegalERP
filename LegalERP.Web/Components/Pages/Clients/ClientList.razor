@page "/clients"
@using LegalERP.Application.Clients
@using LegalERP.Web.Services
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.Toast.IToastService ToastService
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["ClientsManagement"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="ios-title mb-0">@Loc["Clients"]</h1>
    <div class="d-flex gap-2">
        <a href="/attorneys" class="ios-btn ios-btn-secondary text-decoration-none">
            <i class="fa-solid fa-file-contract me-1"></i> @Loc["Attorneys"]
        </a>
        <AuthorizeView Roles="SuperAdmin,Admin,Editor">
            <Authorized>
                <a href="/clients/new" class="ios-btn ios-btn-primary text-decoration-none">
                    <i class="fa-solid fa-plus me-1"></i> @Loc["AddClient"]
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<!-- Search Controls -->
<div class="ios-widget-card mb-4 p-3 p-md-4">
    <div class="row g-3 align-items-end w-100 m-0">
        <div class="col-12 col-md-8 px-1">
            <label class="form-label font-weight-bold ios-details">@Loc["SearchByName"]</label>
            <input type="text" class="ios-input" placeholder="@Loc["SearchClientsPlaceholder"]" 
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        </div>
        <div class="col-12 col-md-4 px-1 d-flex gap-2">
            <button class="ios-btn ios-btn-primary w-100" @onclick="ApplySearch">@Loc["Search"]</button>
            <button class="ios-btn ios-btn-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
        </div>
    </div>
</div>

@if (clients is null)
{
    <p>@Loc["Loading"]</p>
}
else if (totalCount == 0)
{
    <div class="alert alert-info">
        @Loc["NoClientsFound"] 
        <AuthorizeView Roles="SuperAdmin,Admin,Editor">
            <Authorized>
                <a href="/clients/new">@Loc["AddFirstClient"]</a>.
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="ios-table-container">
        <table class="ios-table">
            <thead>
                <tr>
                    <th class="d-none d-md-table-cell">@Loc["FileNumber"]</th>
                    <th>@Loc["FullName"]</th>
                    <th class="d-none d-md-table-cell">@Loc["NationalID"]</th>
                    <th>@Loc["Phone"]</th>
                    <th class="text-center">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clients)
                {
                    <tr>
                        <td class="d-none d-md-table-cell">
                            @if (!string.IsNullOrWhiteSpace(c.FileNumber))
                            {
                                <span class="ios-status-badge ios-status-gray">@c.FileNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <strong>@c.FullName</strong>
                            @if (!string.IsNullOrWhiteSpace(c.FileNumber))
                            {
                                <div class="d-md-none text-muted small mt-1">@Loc["FileNumber"]: @c.FileNumber</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.NationalIdNumber))
                            {
                                <div class="d-md-none text-muted small mt-1">@c.NationalIdNumber</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@(c.NationalIdNumber ?? "—")</td>
                        <td>@(c.PhoneNumber ?? "—")</td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                <a href="/clients/@c.Id" class="ios-btn ios-btn-info text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["View"]</a>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <a href="/clients/edit/@c.Id" class="ios-btn ios-btn-secondary text-decoration-none m-0" style="padding: 4px 8px; font-size: 0.8rem;">@Loc["Edit"]</a>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin,Admin,Editor">
                                    <Authorized>
                                        <button class="ios-btn ios-btn-danger m-0" style="padding: 4px 8px; font-size: 0.8rem;" @onclick="() => DeleteClient(c.Id)">@Loc["Delete"]</button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (totalCount > 0)
    {
        var startItem = (currentPage - 1) * pageSize + 1;
        var endItem = Math.Min(currentPage * pageSize, totalCount);

        <div class="row align-items-center g-2 mt-3 px-1 py-2">
            <div class="col-12 col-md-4 text-center text-md-start">
                <span class="ios-details text-muted small">
                    @Loc["Showing"] <strong>@startItem</strong> @Loc["To"] <strong>@endItem</strong> @Loc["Of"] <strong>@totalCount</strong> @Loc["Clients"]
                </span>
            </div>

            <div class="col-12 col-md-4 d-flex justify-content-center align-items-center gap-2">
                <button type="button"
                        class="ios-btn ios-btn-secondary ios-pagination-pill pagination-prev m-0"
                        style="padding: 4px 14px; font-size: 0.8rem; border-radius: 50px; height: 32px;"
                        disabled="@(!hasPreviousPage)"
                        @onclick="() => GoToPage(currentPage - 1)">
                    <i class="fa-solid fa-chevron-left rtl-flip"></i>
                    <span>@Loc["Previous"]</span>
                </button>

                <span class="ios-btn ios-btn-primary ios-pagination-indicator-pill pagination-indicator m-0"
                      style="padding: 4px 16px; font-size: 0.8rem; border-radius: 50px; height: 32px; font-weight: 700; pointer-events: none; white-space: nowrap;">
                    @Loc["Page"] @currentPage / @Math.Max(1, totalPages)
                </span>

                <button type="button"
                        class="ios-btn ios-btn-secondary ios-pagination-pill pagination-next m-0"
                        style="padding: 4px 14px; font-size: 0.8rem; border-radius: 50px; height: 32px;"
                        disabled="@(!hasNextPage)"
                        @onclick="() => GoToPage(currentPage + 1)">
                    <span>@Loc["Next"]</span>
                    <i class="fa-solid fa-chevron-right rtl-flip"></i>
                </button>
            </div>

            <div class="col-12 col-md-4 d-flex justify-content-center justify-content-md-end align-items-center gap-1">
                <label class="ios-details text-muted mb-0 small">@Loc["RowsPerPage"]:</label>
                <select class="ios-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.8rem; height: 30px; border-radius: 20px;" value="@pageSize" @onchange="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    }
}

@code {
    private List<ClientSummaryDto>? clients;
    private string? searchTerm;
    private string? appliedSearchTerm;

    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int totalPages = 1;
    private bool hasPreviousPage => currentPage > 1;
    private bool hasNextPage => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch(1);
    }

    private async Task ApplySearch()
    {
        appliedSearchTerm = searchTerm;
        await PerformSearch(1);
    }

    private async Task PerformSearch(int page)
    {
        currentPage = Math.Max(1, page);
        var paged = string.IsNullOrWhiteSpace(appliedSearchTerm)
            ? await ClientApi.GetPagedAsync(currentPage, pageSize)
            : await ClientApi.SearchPagedAsync(appliedSearchTerm, currentPage, pageSize);

        clients = paged.Items;
        totalCount = paged.TotalCount;
        currentPage = paged.PageNumber;
        pageSize = paged.PageSize;
        totalPages = paged.TotalPages;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            await PerformSearch(1);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages) || page == currentPage)
            return;
        await PerformSearch(page);
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        appliedSearchTerm = null;
        currentPage = 1;
        await PerformSearch(1);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplySearch();
        }
    }

    private async Task DeleteClient(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteClient"]);
        if (confirmed)
        {
            await ClientApi.DeleteAsync(id);
            ToastService.ShowSuccess(Loc["ClientDeleted"].Value);
            var targetPage = (clients?.Count == 1 && currentPage > 1) ? currentPage - 1 : currentPage;
            await PerformSearch(targetPage);
        }
    }
}



