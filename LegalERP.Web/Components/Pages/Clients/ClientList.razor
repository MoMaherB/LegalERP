@page "/clients"
@using LegalERP.Application.Clients
@using LegalERP.Web.Services
@inject ClientApiClient ClientApi
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["ClientsManagement"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="ios-title">@Loc["Clients"]</h1>
    <a href="/clients/new" class="ios-btn ios-btn-primary text-decoration-none">@Loc["AddClient"]</a>
</div>

<!-- Search Controls -->
<div class="ios-widget-card mb-4">
    <div class="row g-3 align-items-end w-100 m-0">
        <div class="col-md-8">
            <label class="form-label font-weight-bold ios-details">@Loc["SearchByName"]</label>
            <input type="text" class="ios-input" placeholder="@Loc["SearchClientsPlaceholder"]" 
                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleKeyUp" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="ios-btn ios-btn-primary w-100" @onclick="PerformSearch">@Loc["Search"]</button>
            <button class="ios-btn ios-btn-secondary" @onclick="ResetSearch">@Loc["Reset"]</button>
        </div>
    </div>
</div>

@if (clients is null)
{
    <p>@Loc["Loading"]</p>
}
else if (clients.Count == 0)
{
    <div class="alert alert-info">
        @Loc["NoClientsFound"] <a href="/clients/new">@Loc["AddFirstClient"]</a>.
    </div>
}
else
{
    <div class="ios-table-container">
        <table class="ios-table">
            <thead>
                <tr>
                    <th>@Loc["FullName"]</th>
                    <th>@Loc["NationalId"]</th>
                    <th>@Loc["Phone"]</th>
                    <th class="text-center">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clients)
                {
                    <tr>
                        <td><strong>@c.FullName</strong></td>
                        <td>@(c.NationalIdNumber ?? "—")</td>
                        <td>@(c.PhoneNumber ?? "—")</td>
                        <td class="text-center">
                            <a href="/clients/@c.Id" class="ios-btn ios-btn-secondary me-1 text-decoration-none" style="padding: 4px 10px; font-size: 0.85rem;">@Loc["View"]</a>
                            <a href="/clients/edit/@c.Id" class="ios-btn ios-btn-secondary me-1 text-decoration-none" style="padding: 4px 10px; font-size: 0.85rem;">@Loc["Edit"]</a>
                            <button class="ios-btn ios-btn-danger" style="padding: 4px 10px; font-size: 0.85rem;" @onclick="() => DeleteClient(c.Id)">@Loc["Delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ClientSummaryDto>? clients;
    private string? searchTerm;

    protected override async Task OnInitializedAsync()
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            clients = await ClientApi.GetAllAsync();
        }
        else
        {
            clients = await ClientApi.SearchAsync(searchTerm);
        }
    }

    private async Task ResetSearch()
    {
        searchTerm = null;
        await PerformSearch();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task DeleteClient(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", Loc["ConfirmDeleteClient"]);
        if (confirmed)
        {
            await ClientApi.DeleteAsync(id);
            await PerformSearch();
        }
    }
}
