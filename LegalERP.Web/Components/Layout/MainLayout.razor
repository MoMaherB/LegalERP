@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject LegalERP.Web.Services.CustomAuthStateProvider AuthState
@inject LegalERP.Web.Services.AuthApiClient AuthApi
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@using System.Security.Claims
@inject IStringLocalizer<SharedResources> Loc

<div class="page" style="flex-direction: column;">
    <main style="flex: 1;">
        <nav class="navbar navbar-expand-lg navbar-light glass-navbar px-4 py-2" style="border-bottom: 1px solid rgba(255,255,255,0.1); position: relative; z-index: 1050;">
            <div class="container-fluid p-0">
                <a class="navbar-brand modern-brand text-decoration-none" href="">
                    <i class="fa-solid fa-pen-nib me-2" style="color: #f59e0b;"></i> ركائز للمحاماة
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar" aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse mt-3 mt-lg-0" id="topNavbar">
                    <div class="navbar-nav me-auto mb-2 mb-lg-0 gap-2 align-items-lg-center">
                        <AuthorizeView>
                            <Authorized>
                                <NavLink class="nav-link ios-nav-link ios-nav-companies" href="companies" Match="NavLinkMatch.Prefix">
                                    <i class="bi bi-building"></i> @Loc["Companies"]
                                </NavLink>
                                <NavLink class="nav-link ios-nav-link ios-nav-clients" href="clients" Match="NavLinkMatch.Prefix">
                                    <i class="bi bi-people"></i> @Loc["Clients"]
                                </NavLink>
                                <NavLink class="nav-link ios-nav-link ios-nav-attorneys" href="attorneys" Match="NavLinkMatch.Prefix">
                                    <i class="fa-solid fa-file-contract"></i> @Loc["Attorneys"]
                                </NavLink>
                                <NavLink class="nav-link ios-nav-link ios-nav-cases" href="cases" Match="NavLinkMatch.Prefix">
                                    <i class="bi bi-briefcase"></i> @Loc["Cases"]
                                </NavLink>
                                <AuthorizeView Roles="SuperAdmin,Admin" Context="FinContext">
                                    <Authorized>
                                        <NavLink class="nav-link ios-nav-link ios-nav-financials" href="financials" Match="NavLinkMatch.Prefix">
                                            <i class="bi bi-cash-stack"></i> @Loc["Financials"]
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin" Context="UserContext">
                                    <Authorized>
                                        <NavLink class="nav-link ios-nav-link" href="admin/users" Match="NavLinkMatch.Prefix" style="background: rgba(255, 255, 255, 0.05); color: #dee2e6;">
                                            <i class="fa-solid fa-users-gear"></i> @Loc["UserManagement"]
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="SuperAdmin" Context="BackupContext">
                                    <Authorized>
                                        <NavLink class="nav-link ios-nav-link ios-nav-backups" href="admin/backups" Match="NavLinkMatch.Prefix" style="background: rgba(255, 255, 255, 0.05); color: #dee2e6;">
                                            <i class="fa-solid fa-shield-halved"></i> @Loc["Backups"]
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                    <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0 pb-2 pb-lg-0 pt-2 pt-lg-0">
                        <LegalERP.Web.Components.Shared.NotificationBell />
                        <LegalERP.Web.Components.Shared.LanguageSwitcher />
                        <LegalERP.Web.Components.Shared.ThemeSwitcher />
                        
                        <AuthorizeView>
                            <Authorized>
                                <div class="dropdown ms-2">
                                    <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-0 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--text-color);">
                                        <div class="rounded-circle overflow-hidden shadow-sm d-flex justify-content-center align-items-center" style="width: 35px; height: 35px; background: rgba(255,255,255,0.1);">
                                            @if (!string.IsNullOrEmpty(AuthState.GetCachedUser()?.ProfilePicturePath))
                                            {
                                                <img src="/api/documents/download?path=@Uri.EscapeDataString(AuthState.GetCachedUser()!.ProfilePicturePath!)" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-user small"></i>
                                            }
                                        </div>
                                        <span class="d-none d-lg-inline fw-bold">@context.User.FindFirst(ClaimTypes.Name)?.Value</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="background: var(--glass-bg); backdrop-filter: blur(10px);">
                                        <li><a class="dropdown-item" href="profile"><i class="fa-solid fa-id-card me-2 text-primary"></i> @Loc["MyProfile"]</a></li>
                                        <AuthorizeView Roles="SuperAdmin" Context="AdminDropContext">
                                            <Authorized>
                                                <li><a class="dropdown-item" href="admin/backups"><i class="fa-solid fa-shield-halved me-2 text-primary"></i> @Loc["Backups"]</a></li>
                                                <li><a class="dropdown-item" href="admin/users"><i class="fa-solid fa-users-gear me-2 text-secondary"></i> @Loc["UserManagement"]</a></li>
                                            </Authorized>
                                        </AuthorizeView>
                                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                                        <li><button class="dropdown-item text-danger" @onclick="HandleLogout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> @Loc["Logout"]</button></li>
                                    </ul>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </nav>

        <article class="content px-2 px-sm-3 px-md-4">
            @Body
        </article>
        <LegalERP.Web.Components.Shared.ToastContainer />
    </main>
</div>

@code {
    private bool IsHomePage => NavManager.ToBaseRelativePath(NavManager.Uri) == "";

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        AuthState.AuthenticationStateChanged += (t) => InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        try
        {
            await JS.InvokeVoidAsync("authHelper.logout");
        }
        catch {}
        await AuthApi.LogoutAsync();
        AuthState.NotifyUserLoggedOut();
        NavManager.NavigateTo("/login", forceLoad: true);
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
