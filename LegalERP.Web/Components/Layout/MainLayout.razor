@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar glass-navbar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-2 glass-navbar">
            <LegalERP.Web.Components.Shared.RoleSwitcher />
            <LegalERP.Web.Components.Shared.NotificationBell />
            <LegalERP.Web.Components.Shared.LanguageSwitcher />
            <LegalERP.Web.Components.Shared.ThemeSwitcher />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
