@using LegalERP.Web.Services
@inject MockAuthService Auth
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LegalERP.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="companies">
                <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Companies
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clients">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Clients (الموكلين)
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cases">
                <span class="bi bi-briefcase-nav-menu" aria-hidden="true"></span> Cases
            </NavLink>
        </div>
        @if (Auth.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="financials">
                    <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> Financials
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Auth.OnRoleChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnRoleChanged -= StateHasChanged;
    }
}

