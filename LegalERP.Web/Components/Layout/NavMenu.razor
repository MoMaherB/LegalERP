@using LegalERP.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand modern-brand" href="">
            <i class="fa-solid fa-pen-nib me-2" style="color: #f59e0b;"></i> ركائز للمحاماة
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-home" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Loc["Home"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-companies" href="companies">
                <span class="bi bi-building-nav-menu" aria-hidden="true"></span> @Loc["Companies"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-clients" href="clients">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @Loc["Clients"]
            </NavLink>
        </div>
        <div class="nav-item px-3 nav-sub-item">
            <NavLink class="nav-link nav-attorneys" href="attorneys">
                <i class="fa-solid fa-file-contract me-2 ms-1" style="font-size: 1.15rem; color: #14b8a6;"></i> @Loc["Attorneys"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-cases" href="cases">
                <span class="bi bi-briefcase-nav-menu" aria-hidden="true"></span> @Loc["Cases"]
            </NavLink>
        </div>
        <AuthorizeView Roles="SuperAdmin,Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-financials" href="financials">
                        <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> @Loc["Financials"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="SuperAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-backups" href="admin/backups">
                        <i class="fa-solid fa-shield-halved me-2 ms-1" style="font-size: 1.15rem; color: #3b82f6;"></i> @Loc["Backups"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

